NODE_ENV=development
PORT=3000
HOST=127.0.0.1
SESSION_SECRET=change-this-session-secret
JWT_SECRET=change-this-jwt-secret
APP_ORIGIN=http://localhost:3000
ALLOW_SAMPLE_DATA_FALLBACK=true
TRUST_PROXY=1
JWT_EXPIRES_IN=8h
GLOBAL_RATE_LIMIT=5000
STATIC_RATE_LIMIT=20000
AUTH_RATE_LIMIT=30
REGISTRATION_RATE_LIMIT=10
ACCOUNT_RECOVERY_RATE_LIMIT=10
AI_RATE_LIMIT=30
AI_ALLOWED_OPENAI_BASE_URL_ORIGINS=
AI_ALLOWED_NVIDIA_BASE_URL_ORIGINS=
AI_ALLOWED_OPENROUTER_BASE_URL_ORIGINS=
BODY_LIMIT=2mb

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=math_revision_ai_tutor
DB_CONNECTION_LIMIT=30
DB_QUEUE_LIMIT=100
DB_CONNECT_TIMEOUT_MS=10000
# Remote production must use verify-ca. required encrypts without authenticating the server.
DB_SSL_MODE=disabled
DB_SSL_CA_FILE=

AI_PROVIDER=gemini
AI_AUTOMATION_ENABLED=true
AI_JSON_TIMEOUT_MS=45000
AI_ENABLED_GRADES=3,4,5
AI_MAX_HINTS_PER_QUESTION=2
AI_MAX_HINTS_PER_SESSION=8
AI_MAX_REQUESTS_PER_STUDENT_PER_DAY=30
AI_REQUIRE_ANSWER_BEFORE_HELP=true
AI_LOG_RETENTION_DAYS=90
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CLI_MODEL=gemini-2.5-flash-lite
GEMINI_CLI_TIMEOUT_MS=120000
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
API_KEY_ENCRYPTION_SECRET=change_me_for_admin_saved_api_keys

# Email verification and password recovery. Use an app password, never a mailbox password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Toán Bổ Trợ Tiểu học <no-reply@example.com>
EMAIL_OTP_SECRET=change-this-email-otp-secret-at-least-32-characters

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
