{
  "name": "math-revision-ai-tutor",
  "version": "0.1.0",
  "description": "Website ôn luyện Toán Tiểu học lớp 1-5 với gợi ý học tập có kiểm soát.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "db:init": "mysql -u %DB_USER% -p%DB_PASSWORD% %DB_NAME% < database/database_schema.sql",
    "db:seed-curriculum": "node scripts/seed_curriculum.js",
    "db:seed-questions": "node scripts/generate_and_seed_questions.js",
    "db:crawl-questions": "node scripts/crawl_vietjack_questions.js",
    "questions:export-crawl": "python scripts/crawl_public_questions_docx.py",
    "questions:import-crawl": "node scripts/import_crawled_questions.js",
    "questions:build-grade5-bank": "python scripts/build_grade5_question_bank.py",
    "questions:build-grade2-bank": "python scripts/build_grade2_complete_question_bank.py",
    "questions:build-grade1-reviewed-bank": "python scripts/build_grade1_complete_question_bank.py",
    "questions:import-grade5-bank": "node scripts/import_grade5_question_bank_tex.js",
    "questions:import-grade2-bank": "node scripts/import_grade2_question_bank_tex.js",
    "questions:build-grade3-bank": "python scripts/build_grade3_complete_question_bank.py",
    "questions:import-grade3-bank": "node scripts/import_grade3_question_bank_tex.js",
    "questions:build-grade4-bank": "python scripts/build_grade4_complete_question_bank.py",
    "questions:import-grade4-bank": "node scripts/import_grade4_question_bank_tex.js",
    "questions:import-grade1-bank": "node scripts/import_grade1_question_bank_tex.js",
    "questions:stats": "python scripts/build_detailed_question_stats_docx.py",
    "questions:validate-all": "node scripts/import_grade1_question_bank_tex.js --validate-only && node scripts/import_grade2_question_bank_tex.js --validate-only && node scripts/import_grade3_question_bank_tex.js --validate-only && node scripts/import_grade4_question_bank_tex.js --validate-only && node scripts/import_grade5_question_bank_tex.js --validate-only",
    "db:chapter-semesters": "node scripts/apply_chapter_semesters.js",
    "db:indexes": "node scripts/apply_performance_indexes.js",
    "db:seed-demo": "mysql -u %DB_USER% -p%DB_PASSWORD% %DB_NAME% < database/seed.sql"
  },
  "keywords": [
    "express",
    "ejs",
    "mysql",
    "math",
    "education"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.2.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "method-override": "^3.0.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
