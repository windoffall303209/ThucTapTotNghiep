          {
            "url": "/images/question-bank/curated/grade-5/batch-065/cau-02-ba-chang-tham-quan.png",
            "alt_text": "Dòng thời gian gồm ba chặng 35 phút và ba lần nghỉ 10 phút"
          }
        ]
      },
      "choices": [
        {
          "key": "A",
          "text": "1 giờ 45 phút"
