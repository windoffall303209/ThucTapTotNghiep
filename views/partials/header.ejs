<%# Mẫu giao diện header kết hợp dữ liệu máy chủ với HTML để hiển thị một màn hình của ứng dụng. %>
<% if (admin) { %>
<header class="admin-mobile-bar">
  <a class="brand admin-mobile-brand" href="/admin/dashboard" aria-label="Về tổng quan quản trị">
    <span class="brand-mark">π</span>
    <span>MathLab Admin</span>
  </a>
  <button
    class="admin-menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="adminSidebar"
    aria-label="Mở menu quản trị"
    data-admin-menu-toggle>
    <i data-lucide="menu" class="lucide-icon"></i>
  </button>
</header>
<div class="admin-sidebar-backdrop" data-admin-sidebar-backdrop hidden></div>
<aside id="adminSidebar" class="admin-sidebar" aria-label="Menu quản trị">
  <a class="brand admin-brand" href="/admin/dashboard" aria-label="Về tổng quan quản trị">
    <span class="brand-mark">π</span>
    <span>MathLab Admin</span>
  </a>

  <nav class="admin-nav" aria-label="Điều hướng quản trị">
    <span class="admin-nav-label">Tổng quan</span>
    <a href="/admin/dashboard" class="<%= currentPath === '/admin/dashboard' ? 'active' : '' %>" <%- currentPath === '/admin/dashboard' ? 'aria-current="page"' : '' %>>
      <i data-lucide="layout-dashboard" class="lucide-icon"></i>
      Dashboard
    </a>

    <span class="admin-nav-label">Nội dung</span>
    <a href="/admin/curriculum" class="<%= currentPath.startsWith('/admin/curriculum') ? 'active' : '' %>" <%- currentPath.startsWith('/admin/curriculum') ? 'aria-current="page"' : '' %>>
      <i data-lucide="list-tree" class="lucide-icon"></i>
      Khung chương trình
    </a>
    <a href="/admin/questions" class="<%= currentPath.startsWith('/admin/questions') ? 'active' : '' %>" <%- currentPath.startsWith('/admin/questions') ? 'aria-current="page"' : '' %>>
      <i data-lucide="list-checks" class="lucide-icon"></i>
      Ngân hàng câu hỏi
    </a>
    <a href="/admin/theory" class="<%= currentPath.startsWith('/admin/theory') ? 'active' : '' %>" <%- currentPath.startsWith('/admin/theory') ? 'aria-current="page"' : '' %>>
      <i data-lucide="book-open" class="lucide-icon"></i>
      Kho lý thuyết
    </a>

    <span class="admin-nav-label">Giám sát</span>
    <a href="/admin/logs/ai" class="<%= currentPath.startsWith('/admin/logs') ? 'active' : '' %>" <%- currentPath.startsWith('/admin/logs') ? 'aria-current="page"' : '' %>>
      <i data-lucide="message-square" class="lucide-icon"></i>
      Nhật ký AI
    </a>

    <%# Khối xử lý trong mẫu quyết định nội dung giao diện dựa trên dữ liệu máy chủ. %>
    <% if (admin.role === 'SYSADMIN') { %>
      <span class="admin-nav-label">Hệ thống</span>
      <a href="/admin/students" class="<%= currentPath.startsWith('/admin/students') ? 'active' : '' %>" <%- currentPath.startsWith('/admin/students') ? 'aria-current="page"' : '' %>>
        <i data-lucide="users" class="lucide-icon"></i>
        Tài khoản học sinh
      </a>
      <a href="/admin/settings" class="<%= currentPath.startsWith('/admin/settings') ? 'active' : '' %>" <%- currentPath.startsWith('/admin/settings') ? 'aria-current="page"' : '' %>>
        <i data-lucide="settings" class="lucide-icon"></i>
        API & cài đặt
      </a>
    <% } %>
  </nav>

  <div class="admin-sidebar-footer">
    <div>
      <strong><%= admin.fullname %></strong>
      <small><%= admin.role === 'SYSADMIN' ? 'Quản trị hệ thống' : 'Quản trị nội dung' %></small>
    </div>
    <form action="/auth/logout" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="nav-button" type="submit">
        <i data-lucide="log-out" class="lucide-icon"></i>
        Đăng xuất
      </button>
    </form>
  </div>
</aside>
<% } else { %>
<header class="topbar">
  <a class="brand" href="/" aria-label="Về trang chủ Toán Bổ Trợ">
    <span class="brand-mark">π</span>
    <span>Toán Bổ Trợ Tiểu học</span>
  </a>

  <nav class="nav-links" aria-label="Điều hướng chính">
    <%# Khối xử lý trong mẫu quyết định nội dung giao diện dựa trên dữ liệu máy chủ. %>
    <% if (student) { %>
      <%# Nhãn và điều kiện active phải TRÙNG với bottom-nav bên dưới: cùng một
          trang mà thanh trên gọi "Hôm nay", thanh dưới gọi "Học" thì trẻ tưởng
          là hai nơi khác nhau. %>
      <a href="/student/dashboard" class="<%= currentPath === '/student/dashboard' || currentPath.startsWith('/student/lessons') ? 'active' : '' %>" <%- currentPath === '/student/dashboard' || currentPath.startsWith('/student/lessons') ? 'aria-current="page"' : '' %>>
        <i data-lucide="sparkles" class="lucide-icon"></i>
        Học bài
      </a>
      <a href="/student/exams" class="<%= currentPath.startsWith('/student/exams') || currentPath.startsWith('/student/sessions') ? 'active' : '' %>" <%- currentPath.startsWith('/student/exams') || currentPath.startsWith('/student/sessions') ? 'aria-current="page"' : '' %>>
        <i data-lucide="clipboard-list" class="lucide-icon"></i>
        Luyện tập
      </a>
      <a href="/student/history" class="<%= currentPath.startsWith('/student/history') ? 'active' : '' %>" <%- currentPath.startsWith('/student/history') ? 'aria-current="page"' : '' %>>
        <i data-lucide="history" class="lucide-icon"></i>
        Lịch sử
      </a>
      <a href="/student/account" class="<%= currentPath.startsWith('/student/account') ? 'active' : '' %>" <%- currentPath.startsWith('/student/account') ? 'aria-current="page"' : '' %>>
        <i data-lucide="user-circle" class="lucide-icon"></i>
        Tài khoản
      </a>
      <form action="/auth/logout" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="nav-button" type="submit">
          <i data-lucide="log-out" class="lucide-icon"></i>
          Đăng xuất
        </button>
      </form>
    <% } else { %>
      <a class="nav-anchor" href="/#cach-hoc">Cách học</a>
      <a class="nav-anchor" href="/#chuong-trinh">Lớp <%= shortGradeRangeLabel %></a>
      <a href="/auth/login">
        <i data-lucide="log-in" class="lucide-icon"></i>
        Đăng nhập
      </a>
      <a class="nav-primary" href="/auth/register">
        <i data-lucide="user-plus" class="lucide-icon"></i>
        Bắt đầu học
      </a>
    <% } %>
  </nav>
</header>

<%# Khối xử lý trong mẫu quyết định nội dung giao diện dựa trên dữ liệu máy chủ. %>
<% if (student) { %>
<nav class="bottom-nav" aria-label="Điều hướng nhanh">
  <a href="/student/dashboard" class="<%= currentPath === '/student/dashboard' || currentPath.startsWith('/student/lessons') ? 'active' : '' %>" <%- currentPath === '/student/dashboard' || currentPath.startsWith('/student/lessons') ? 'aria-current="page"' : '' %>>
    <i data-lucide="sparkles" class="lucide-icon"></i>
    <span>Học bài</span>
  </a>
  <a href="/student/exams" class="<%= currentPath.startsWith('/student/exams') || currentPath.startsWith('/student/sessions') ? 'active' : '' %>" <%- currentPath.startsWith('/student/exams') || currentPath.startsWith('/student/sessions') ? 'aria-current="page"' : '' %>>
    <i data-lucide="clipboard-list" class="lucide-icon"></i>
    <span>Luyện tập</span>
  </a>
  <a href="/student/history" class="<%= currentPath.startsWith('/student/history') ? 'active' : '' %>" <%- currentPath.startsWith('/student/history') ? 'aria-current="page"' : '' %>>
    <i data-lucide="history" class="lucide-icon"></i>
    <span>Lịch sử</span>
  </a>
  <a href="/student/account" class="<%= currentPath.startsWith('/student/account') ? 'active' : '' %>" <%- currentPath.startsWith('/student/account') ? 'aria-current="page"' : '' %>>
    <i data-lucide="user-circle" class="lucide-icon"></i>
    <span>Tài khoản</span>
  </a>
</nav>
<% } %>
<% } %>
