<section class="workspace-head">
  <div>
    <p class="eyebrow">Quản lý học sinh</p>
    <h1>Danh sách học sinh</h1>
    <p>Tìm kiếm tài khoản học sinh và kiểm tra khối học hiện tại.</p>
  </div>
</section>

<form class="search-bar" action="/admin/students" method="get">
  <input name="q" value="<%= query %>" placeholder="Tìm theo tên hoặc tài khoản">
  <button class="btn btn-secondary" type="submit">
    <i data-lucide="search" class="lucide-icon"></i>
    Tìm kiếm
  </button>
</form>

<section class="table-section">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Tài khoản</th>
          <th>Họ tên</th>
          <th>Khối đăng ký</th>
          <th>Khối hiện tại</th>
        </tr>
      </thead>
      <tbody>
        <% if (students.length === 0) { %>
          <tr>
            <td colspan="5">Chưa có học sinh phù hợp.</td>
          </tr>
        <% } %>
        <% students.forEach((item) => { %>
          <tr>
            <td><%= item.id %></td>
            <td><%= item.username %></td>
            <td><%= item.fullname %></td>
            <td>Lớp <%= item.registered_grade %></td>
            <td>Lớp <%= item.current_grade %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
