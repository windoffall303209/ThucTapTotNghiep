<section class="workspace-head">
  <div>
    <p class="eyebrow">Người học</p>
    <h1>Danh sách học sinh</h1>
    <p>Tìm kiếm tài khoản học sinh, sửa khối lớp và đặt lại mật khẩu khi học sinh quên.</p>
  </div>
</section>

<form class="search-bar" action="/admin/students" method="get">
  <input name="q" value="<%= query %>" placeholder="Tìm theo tên hoặc tài khoản">
  <%# Lọc theo lớp: danh sách trải cả 5 khối, không lọc thì tìm học sinh của
      một lớp cụ thể phải cuộn qua toàn trường. %>
  <select name="grade">
    <option value="">Tất cả lớp</option>
    <% gradeOptions.forEach((option) => { %>
      <option value="<%= option.value %>" <%= Number(filterGrade) === Number(option.value) ? 'selected' : '' %>>
        <%= option.label %>
      </option>
    <% }) %>
  </select>
  <button class="btn btn-secondary" type="submit">
    <i data-lucide="search" class="lucide-icon"></i>
    Tìm kiếm
  </button>
</form>

<section class="table-section">
  <div class="section-title">
    <i data-lucide="users" class="lucide-icon"></i>
    Tài khoản học sinh
    <small class="muted"><%= pagination.total %> tài khoản · Trang <%= pagination.page %>/<%= pagination.totalPages %></small>
  </div>

  <% if (students.length === 0) { %>
    <div class="empty-state compact">
      <p>Không tìm thấy học sinh phù hợp.</p>
    </div>
  <% } %>

  <div class="card-list">
    <% students.forEach((item) => { %>
      <% const ngoaiPhamVi = !gradeOptions.some((option) => Number(option.value) === Number(item.current_grade)); %>
      <article class="activity-card student-card">
        <div class="row-actions">
          <span class="status-pill status-new">#<%= item.id %></span>
          <span class="status-pill <%= ngoaiPhamVi ? 'status-review' : 'status-in-progress' %>">
            Lớp hiện tại: <%= item.current_grade %>
          </span>
          <span class="status-pill status-new">Lớp đăng ký: <%= item.registered_grade %></span>
        </div>

        <h2><%= item.fullname %></h2>
        <p class="muted">
          Tên đăng nhập: <strong><%= item.username %></strong>
          <%# Lần làm bài gần nhất giúp phân biệt tài khoản đang học thật với
              tài khoản tạo ra rồi bỏ. %>
          · Làm bài gần nhất:
          <strong><%= item.last_activity_at ? new Date(item.last_activity_at).toLocaleString('vi-VN') : 'Chưa làm bài nào' %></strong>
        </p>

        <% if (ngoaiPhamVi) { %>
          <p class="student-warning">
            <i data-lucide="alert-triangle" class="lucide-icon"></i>
            Khối lớp này ngoài phạm vi hệ thống hỗ trợ nên học sinh không đăng nhập được.
            Hãy chuyển về một lớp trong danh sách bên dưới.
          </p>
        <% } %>

        <div class="student-actions">
          <%# Đổi khối lớp thay đổi toàn bộ chương trình mà học sinh nhìn thấy,
              nên bắt xác nhận trước khi lưu để không lỡ tay chọn nhầm dòng. %>
          <form
            class="inline-action-form"
            action="/admin/students/<%= item.id %>/grade"
            method="post"
            data-confirm="Đổi khối lớp của <%= item.fullname %>? Học sinh sẽ thấy chương trình của khối mới ngay lần đăng nhập tới.">
            <input type="hidden" name="q" value="<%= query %>">
            <label>
              Khối lớp hiện tại
              <select name="current_grade">
                <% gradeOptions.forEach((option) => { %>
                  <option value="<%= option.value %>" <%= Number(option.value) === Number(item.current_grade) ? 'selected' : '' %>>
                    <%= option.label %>
                  </option>
                <% }) %>
              </select>
            </label>
            <button class="btn btn-secondary" type="submit">
              <i data-lucide="graduation-cap" class="lucide-icon"></i>
              Lưu khối lớp
            </button>
          </form>

          <%# type=password để mật khẩu mới không nằm trần trên màn hình nơi
              đông người nhìn; kèm xác nhận vì thao tác này vô hiệu hóa mật khẩu
              cũ của học sinh ngay lập tức. %>
          <form
            class="inline-action-form"
            action="/admin/students/<%= item.id %>/password"
            method="post"
            data-confirm="Đặt lại mật khẩu cho <%= item.fullname %>? Mật khẩu cũ sẽ không dùng được nữa.">
            <input type="hidden" name="q" value="<%= query %>">
            <label>
              Mật khẩu mới
              <input
                name="new_password"
                type="password"
                minlength="8"
                required
                autocomplete="new-password"
                placeholder="Tối thiểu 8 ký tự">
            </label>
            <button class="btn btn-secondary" type="submit">
              <i data-lucide="key-round" class="lucide-icon"></i>
              Đặt lại mật khẩu
            </button>
          </form>
        </div>
      </article>
    <% }) %>
  </div>

  <% if (pagination.totalPages > 1) { %>
    <%
      // Giữ nguyên từ khóa và bộ lọc lớp khi lật trang.
      function trangUrl(p) {
        const params = new URLSearchParams();
        if (query) params.set('q', query);
        if (filterGrade) params.set('grade', String(filterGrade));
        params.set('page', String(p));
        return `/admin/students?${params.toString()}`;
      }
    %>
    <nav class="question-pagination" aria-label="Phân trang học sinh">
      <a class="btn btn-secondary btn-compact <%= pagination.page <= 1 ? 'disabled-link' : '' %>"
         href="<%= pagination.page <= 1 ? '#' : trangUrl(pagination.page - 1) %>">
        <i data-lucide="chevron-left" class="lucide-icon"></i>
        Trước
      </a>
      <span>Trang <strong><%= pagination.page %></strong>/<%= pagination.totalPages %> · <%= pagination.total %> tài khoản</span>
      <a class="btn btn-secondary btn-compact <%= pagination.page >= pagination.totalPages ? 'disabled-link' : '' %>"
         href="<%= pagination.page >= pagination.totalPages ? '#' : trangUrl(pagination.page + 1) %>">
        Sau
        <i data-lucide="chevron-right" class="lucide-icon"></i>
      </a>
    </nav>
  <% } %>
</section>
