<section class="workspace-head">
  <div>
    <p class="eyebrow">Người học</p>
    <h1>Danh sách học sinh</h1>
    <p>Tìm kiếm tài khoản học sinh, kiểm tra lớp đăng ký và lớp hiện tại.</p>
  </div>
</section>

<form class="search-bar" action="/admin/students" method="get">
  <input name="q" value="<%= query %>" placeholder="Tìm theo tên hoặc tài khoản">
  <button class="btn btn-secondary" type="submit">
    <i data-lucide="search" class="lucide-icon"></i>
    Tìm kiếm
  </button>
</form>

<section class="table-section">
  <div class="section-title">
    <i data-lucide="users" class="lucide-icon"></i>
    Tài khoản học sinh
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Tài khoản</th>
          <th>Họ tên</th>
          <th>Lớp đăng ký</th>
          <th>Lớp hiện tại</th>
        </tr>
      </thead>
      <tbody>
        <% if (students.length === 0) { %>
          <tr>
            <td colspan="5">Không tìm thấy học sinh phù hợp.</td>
          </tr>
        <% } %>
        <% students.forEach((item) => { %>
          <tr>
            <td>#<%= item.id %></td>
            <td><strong><%= item.username %></strong></td>
            <td><%= item.fullname %></td>
            <td><span class="status-pill status-new">Lớp <%= item.registered_grade %></span></td>
            <td><span class="status-pill status-in-progress">Lớp <%= item.current_grade %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
