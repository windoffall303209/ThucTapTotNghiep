<%
  const cards = Array.isArray(lesson.theory_cards) ? lesson.theory_cards : [];
  const theoryTypes = [
    { value: 'observe', label: 'Quan sát hình' },
    { value: 'concept', label: 'Khái niệm / quy tắc' },
    { value: 'model', label: 'Ví dụ mẫu' },
    { value: 'quick_try', label: 'Thử nhanh' },
    { value: 'remember', label: 'Ghi nhớ' }
  ];
  const theoryLayouts = [
    { value: 'text_first', label: 'Chữ trước' },
    { value: 'visual_top', label: 'Ảnh lớn phía trên' },
    { value: 'visual_left', label: 'Ảnh trái' },
    { value: 'visual_right', label: 'Ảnh phải' },
    { value: 'step_focus', label: 'Từng bước' },
    { value: 'compact', label: 'Gọn nhẹ' }
  ];
  const interactionOptions = [
    { value: 'none', label: 'Không tương tác' },
    { value: 'count', label: 'Đếm' },
    { value: 'choose', label: 'Chọn' },
    { value: 'compare', label: 'So sánh' },
    { value: 'fill_blank', label: 'Điền số' },
    { value: 'match', label: 'Nối/ghép' }
  ];

  function bodyValue(card) {
    const legacyFormulas = Array.isArray(card.formulas)
      ? card.formulas
      : card.formula
        ? [card.formula]
        : [];
    return [card.body || '', ...legacyFormulas].filter(Boolean).join('\n');
  }

  function cardImages(card) {
    return Array.isArray(card.images) ? card.images : [];
  }

  function selected(current, value) {
    return current === value ? 'selected' : '';
  }

  function labelFor(options, value, fallback) {
    return (options.find((item) => item.value === value) || { label: fallback }).label;
  }

  function escapeHtml(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function escapeAttribute(value) {
    return escapeHtml(value).replace(/`/g, '&#096;');
  }
%>

<div class="lesson-question-toolbar">
  <div>
    <span class="bank-kicker">Workspace lý thuyết</span>
    <h2><%= lesson.lesson_name %></h2>
    <p><%= cards.length %> thẻ hiện có. Chọn loại thẻ trước để nhập đúng kiểu nội dung cho từng nhóm lớp.</p>
  </div>
  <a class="btn btn-secondary" href="/student/lessons/<%= lesson.id %>" target="_blank" rel="noreferrer">
    <i data-lucide="external-link" class="lucide-icon"></i>
    Xem trang học sinh
  </a>
</div>

<details class="inline-create-panel theory-create-panel">
  <summary>
    <i data-lucide="plus" class="lucide-icon"></i>
    Thêm thẻ lý thuyết
  </summary>
  <form class="theory-card-form stack-form" action="/admin/theory/<%= lesson.id %>/cards" method="post" enctype="multipart/form-data" data-theory-preview-form>
    <div class="theory-card-fields">
      <div class="two-fields">
        <label>
          Loại thẻ
          <select name="type" data-theory-type>
            <% theoryTypes.forEach((option) => { %>
              <option value="<%= option.value %>"><%= option.label %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Bố cục
          <select name="layout" data-theory-layout>
            <% theoryLayouts.forEach((option) => { %>
              <option value="<%= option.value %>"><%= option.label %></option>
            <% }) %>
          </select>
        </label>
      </div>
      <label>
        Tiêu đề
        <input name="title" placeholder="Ví dụ: Đếm các đồ vật" data-theory-title>
      </label>
      <label>
        Câu hiển thị ngắn
        <input name="display_text" placeholder="Ví dụ: Quan sát hình và đếm số quả táo." data-theory-display-text>
      </label>
      <label>
        Nội dung / các bước
        <textarea name="body" rows="6" placeholder="Nhập ngắn gọn. Mỗi dòng có thể là một bước hoặc một ý." data-theory-body></textarea>
      </label>
      <div class="two-fields">
        <label>
          Nhiệm vụ của học sinh
          <input name="student_task" placeholder="Ví dụ: Em hãy đếm từ trái sang phải." data-theory-student-task>
        </label>
        <label>
          Kiểu tương tác dự kiến
          <select name="interaction" data-theory-interaction>
            <% interactionOptions.forEach((option) => { %>
              <option value="<%= option.value %>"><%= option.label %></option>
            <% }) %>
          </select>
        </label>
      </div>
      <label>
        Ví dụ
        <input name="example" placeholder="Ví dụ minh họa ngắn" data-theory-example>
      </label>
      <label>
        Ghi nhớ
        <input name="remember" placeholder="Một câu chốt ngắn cho học sinh" data-theory-remember>
      </label>
      <label>
        Ảnh minh họa
        <input type="file" name="theory_images" accept="image/png,image/jpeg,image/webp,image/gif" multiple data-theory-images>
      </label>
    </div>
    <aside class="question-form-preview">
      <div class="section-title">
        <i data-lucide="eye" class="lucide-icon"></i>
        Preview thẻ lý thuyết
      </div>
      <div class="theory-preview-box math-content" data-theory-preview></div>
    </aside>
    <div class="form-actions theory-card-actions">
      <button class="btn btn-secondary" type="button" data-close-details>Hủy</button>
      <button class="btn btn-primary" type="submit">
        <i data-lucide="save" class="lucide-icon"></i>
        Lưu thẻ mới
      </button>
    </div>
  </form>
</details>

<% if (cards.length === 0) { %>
  <div class="empty-state compact">Bài học này chưa có thẻ lý thuyết. Hãy thêm ít nhất một thẻ trước khi học sinh luyện bài.</div>
<% } %>

<div class="theory-card-list">
  <% cards.forEach((card, index) => { %>
    <% const images = cardImages(card); %>
    <article class="admin-theory-card theory-card theory-layout-<%= card.layout || 'text_first' %> math-content math-lazy">
      <div class="theory-card-head">
        <div>
          <span class="card-index">Thẻ <%= index + 1 %></span>
          <span class="status-pill status-new"><%= labelFor(theoryTypes, card.type || 'concept', 'Khái niệm') %></span>
          <h2><%= card.title || `Thẻ lý thuyết ${index + 1}` %></h2>
        </div>
        <form action="/admin/theory/<%= lesson.id %>/cards/<%= index %>/delete" method="post" onsubmit="return confirm('Xóa thẻ lý thuyết này?');">
          <button class="btn btn-danger btn-compact" type="submit">
            <i data-lucide="trash-2" class="lucide-icon"></i>
            Xóa
          </button>
        </form>
      </div>

      <% if (card.display_text) { %>
        <p class="theory-display-text"><%= card.display_text %></p>
      <% } %>

      <% if (images.length > 0) { %>
        <div class="theory-image-row">
          <% images.forEach((image) => { %>
            <span class="question-image">
              <img src="<%= image.url %>" alt="<%= image.alt_text || 'Hình minh họa lý thuyết' %>" loading="lazy" decoding="async">
            </span>
          <% }) %>
        </div>
      <% } %>

      <% if (bodyValue(card)) { %>
        <div class="theory-body"><%= bodyValue(card) %></div>
      <% } %>

      <% if (card.student_task) { %>
        <p class="theory-task"><strong>Việc cần làm:</strong> <%= card.student_task %></p>
      <% } %>

      <% if (card.example) { %>
        <p class="muted"><strong>Ví dụ:</strong> <%= card.example %></p>
      <% } %>

      <% if (card.remember) { %>
        <p class="theory-remember"><strong>Ghi nhớ:</strong> <%= card.remember %></p>
      <% } %>

      <details class="inline-edit-panel theory-edit-panel">
        <summary>
          <i data-lucide="pencil" class="lucide-icon"></i>
          Sửa thẻ này
        </summary>
        <form class="theory-card-form stack-form" action="/admin/theory/<%= lesson.id %>/cards/<%= index %>" method="post" enctype="multipart/form-data" data-theory-preview-form>
          <input type="hidden" name="existing_images" value="<%- escapeAttribute(JSON.stringify(images)) %>" data-theory-existing-images>
          <div class="theory-card-fields">
            <div class="two-fields">
              <label>
                Loại thẻ
                <select name="type" data-theory-type>
                  <% theoryTypes.forEach((option) => { %>
                    <option value="<%= option.value %>" <%= selected(card.type || 'concept', option.value) %>><%= option.label %></option>
                  <% }) %>
                </select>
              </label>
              <label>
                Bố cục
                <select name="layout" data-theory-layout>
                  <% theoryLayouts.forEach((option) => { %>
                    <option value="<%= option.value %>" <%= selected(card.layout || 'text_first', option.value) %>><%= option.label %></option>
                  <% }) %>
                </select>
              </label>
            </div>
            <label>
              Tiêu đề
              <input name="title" value="<%= card.title || '' %>" data-theory-title>
            </label>
            <label>
              Câu hiển thị ngắn
              <input name="display_text" value="<%= card.display_text || '' %>" data-theory-display-text>
            </label>
            <label>
              Nội dung / các bước
              <textarea name="body" rows="6" data-theory-body><%= bodyValue(card) %></textarea>
            </label>
            <div class="two-fields">
              <label>
                Nhiệm vụ của học sinh
                <input name="student_task" value="<%= card.student_task || '' %>" data-theory-student-task>
              </label>
              <label>
                Kiểu tương tác dự kiến
                <select name="interaction" data-theory-interaction>
                  <% interactionOptions.forEach((option) => { %>
                    <option value="<%= option.value %>" <%= selected(card.interaction || 'none', option.value) %>><%= option.label %></option>
                  <% }) %>
                </select>
              </label>
            </div>
            <label>
              Ví dụ
              <input name="example" value="<%= card.example || '' %>" data-theory-example>
            </label>
            <label>
              Ghi nhớ
              <input name="remember" value="<%= card.remember || '' %>" data-theory-remember>
            </label>
            <% if (images.length > 0) { %>
              <div class="choice-existing-images">
                <span class="form-note">Ảnh hiện có, tích "Xóa" nếu muốn bỏ khi lưu:</span>
                <% images.forEach((image) => { %>
                  <label class="image-keep-option">
                    <input type="checkbox" name="remove_theory_images" value="<%= image.id || image.url %>" data-preview-remove-image>
                    <span>Xóa</span>
                    <span class="question-image choice-existing-image">
                      <img src="<%= image.url %>" alt="<%= image.alt_text || 'Hình minh họa lý thuyết' %>" loading="lazy" decoding="async">
                    </span>
                  </label>
                <% }) %>
              </div>
            <% } %>
            <label>
              Ảnh minh họa mới
              <input type="file" name="theory_images" accept="image/png,image/jpeg,image/webp,image/gif" multiple data-theory-images>
            </label>
          </div>
          <aside class="question-form-preview">
            <div class="section-title">
              <i data-lucide="eye" class="lucide-icon"></i>
              Preview sau khi sửa
            </div>
            <div class="theory-preview-box math-content" data-theory-preview></div>
          </aside>
          <div class="form-actions theory-card-actions">
            <button class="btn btn-secondary" type="button" data-close-details>Hủy</button>
            <button class="btn btn-primary" type="submit">
              <i data-lucide="save" class="lucide-icon"></i>
              Lưu thẻ này
            </button>
          </div>
        </form>
      </details>
    </article>
  <% }) %>
</div>
