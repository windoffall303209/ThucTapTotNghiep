<%# M?u giao di?n question edit form k?t h?p d? li?u m?y ch? v?i HTML ?? hi?n th? m?t m?n h?nh c?a ?ng d?ng. %>
<%
  const answerKeys = ['A', 'B', 'C', 'D'];
  const difficultyOptions = [
    { value: 'EASY', label: 'Dễ' },
    { value: 'MEDIUM', label: 'Trung bình' },
    { value: 'HARD', label: 'Khó' },
    { value: 'EXPERT', label: 'Nâng cao' }
  ];
  const layoutOptions = [
    { value: 'STACK_VERTICAL', label: 'Chữ và ảnh theo thứ tự' },
    { value: 'VISUAL_TOP', label: 'Ảnh lớn phía trên' },
    { value: 'VISUAL_BOTTOM', label: 'Ảnh phía dưới' },
    { value: 'SPLIT_HORIZONTAL_LEFT_IMAGE', label: 'Ảnh trái, chữ phải' },
    { value: 'SPLIT_HORIZONTAL_RIGHT_IMAGE', label: 'Chữ trái, ảnh phải' },
    { value: 'IMAGE_IN_CHOICES', label: 'Ảnh trong đáp án' },
    { value: 'COMPACT', label: 'Gọn nhẹ' }
  ];
  const misconceptionByKey = new Map((misconceptions || []).map((item) => [item.distractor_key, item]));
  const questionImages = Array.isArray(question.content && question.content.images) ? question.content.images : [];
  const explanationImages = Array.isArray(question.explanation && question.explanation.images) ? question.explanation.images : [];
  const questionType = question.question_type || 'MULTIPLE_CHOICE';
  const layoutVariant = question.content?.layout_variant || question.layout_template || 'STACK_VERTICAL';
  const gridLayout = question.content?.grid_layout || { enabled: false, rows: 5, columns: 5, cells: [] };

  function selected(current, value) {
    return current === value ? 'selected' : '';
  }

  function choiceFor(question, key) {
    return (question.choices || []).find((item) => item.key === key) || { key, text: '', images: [] };
  }

  function escapeHtml(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function escapeAttribute(value) {
    return escapeHtml(value).replace(/`/g, '&#096;');
  }

  function questionText(question) {
    return question.content && question.content.text ? question.content.text : '';
  }

  function explanationText(question) {
    return question.explanation && question.explanation.text ? question.explanation.text : '';
  }
%>

<form class="inline-edit-form stack-form" action="/admin/questions/<%= question.id %>" method="post" enctype="multipart/form-data" data-question-preview-form>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="form-actions form-actions-top">
    <button class="btn btn-secondary" type="button" data-close-details>Hủy</button>
    <button class="btn btn-primary" type="submit">
      <i data-lucide="save" class="lucide-icon"></i>
      Lưu thay đổi
    </button>
  </div>

  <input type="hidden" name="authoring_mode" value="<%= gridLayout.enabled ? 'canvas' : 'fields' %>" data-authoring-mode-input>
  <div class="authoring-mode-switch" data-authoring-mode>
    <label>
      <input type="radio" name="authoring_mode_choice_<%= question.id %>" value="fields" <%= gridLayout.enabled ? '' : 'checked' %>>
      Nhập từng trường
    </label>
    <label>
      <input type="radio" name="authoring_mode_choice_<%= question.id %>" value="canvas" <%= gridLayout.enabled ? 'checked' : '' %>>
      Thiết kế bằng canvas
    </label>
  </div>

  <label>
    Bài học
    <select name="lesson_id" required>
      <%# Kh?i l?p trong m?u t?o n?i dung ??ng t? danh s?ch d? li?u m?y ch?. %>
      <% lessons.forEach((item) => { %>
        <option value="<%= item.id %>" <%= selected(Number(question.lesson_id), Number(item.id)) %>>
          Lớp <%= item.grade %> · <%= item.chapter_name %> · <%= item.lesson_name %>
        </option>
      <% }) %>
    </select>
  </label>

  <div class="two-fields">
    <label>
      Dạng câu hỏi
      <select name="question_type" data-question-type>
        <option value="MULTIPLE_CHOICE" <%= selected(questionType, 'MULTIPLE_CHOICE') %>>Trắc nghiệm A/B/C/D</option>
        <option value="FILL_IN_THE_BLANK" <%= selected(questionType, 'FILL_IN_THE_BLANK') %>>Điền đáp án</option>
      </select>
    </label>
    <label data-author-mode-panel="fields">
      Bố cục hiển thị
      <select name="layout_variant" data-layout-variant>
        <%# Kh?i l?p trong m?u t?o n?i dung ??ng t? danh s?ch d? li?u m?y ch?. %>
        <% layoutOptions.forEach((option) => { %>
          <option value="<%= option.value %>" <%= selected(layoutVariant, option.value) %>><%= option.label %></option>
        <% }) %>
      </select>
    </label>
  </div>

  <div class="two-fields">
    <label>
      Độ khó
      <select name="difficulty">
        <%# Kh?i l?p trong m?u t?o n?i dung ??ng t? danh s?ch d? li?u m?y ch?. %>
        <% difficultyOptions.forEach((option) => { %>
          <option value="<%= option.value %>" <%= selected(question.difficulty, option.value) %>><%= option.label %></option>
        <% }) %>
      </select>
    </label>
    <label data-author-mode-panel="fields">
      Kiểu thao tác
      <select name="question_interaction" data-question-interaction>
        <option value="choose" <%= selected(question.content?.interaction, 'choose') %>>Chọn đáp án</option>
        <option value="fill_blank" <%= selected(question.content?.interaction, 'fill_blank') %>>Điền số/kết quả</option>
        <option value="count" <%= selected(question.content?.interaction, 'count') %>>Đếm hình</option>
        <option value="compare" <%= selected(question.content?.interaction, 'compare') %>>So sánh</option>
        <option value="none" <%= selected(question.content?.interaction || 'none', 'none') %>>Không phân loại</option>
      </select>
    </label>
  </div>

  <label data-author-mode-panel="fields">
    Đề bài
    <textarea name="content_text" rows="5" data-preview-content><%= questionText(question) %></textarea>
  </label>
  <input type="hidden" data-preview-existing-images value="<%- escapeAttribute(JSON.stringify(questionImages)) %>">

  <input type="hidden" name="grid_layout" value="<%- escapeAttribute(JSON.stringify(gridLayout)) %>" data-grid-layout-input>
  <section class="grid-editor" data-grid-editor data-grid-mode="question" data-author-mode-panel="canvas" <%= gridLayout.enabled ? '' : 'hidden' %>>
    <div class="grid-editor-head">
      <label class="toggle-line">
        <input type="checkbox" data-grid-enabled>
        Dùng thiết kế dạng lưới
      </label>
      <div class="grid-size-controls">
        <label>Dòng <input type="number" min="1" max="10" value="5" data-grid-rows></label>
        <label>Cột <input type="number" min="1" max="10" value="5" data-grid-columns></label>
      </div>
    </div>
    <div class="grid-editor-actions">
      <button class="btn btn-secondary btn-compact" type="button" data-grid-merge>Gộp ô</button>
      <button class="btn btn-secondary btn-compact" type="button" data-grid-unmerge>Tách ô</button>
      <button class="btn btn-secondary btn-compact" type="button" data-grid-clear>Để trống ô</button>
    </div>
    <div class="grid-editor-workspace">
      <div class="grid-editor-canvas" data-grid-canvas></div>
      <div class="grid-cell-panel">
        <div class="form-note">Chọn hoặc kéo qua nhiều ô, sau đó gán nội dung cho vùng đang chọn.</div>
        <label>Loại ô
          <select data-grid-cell-type>
            <option value="text">Chữ</option>
            <option value="question_text">Đề bài</option>
            <option value="image">Ảnh</option>
            <option value="formula">Công thức</option>
            <option value="answer">Đáp án chọn</option>
            <option value="free_answer_input">Ô điền đáp án</option>
            <option value="solution">Lời giải</option>
            <option value="instruction">Hướng dẫn</option>
            <option value="empty">Để trống</option>
          </select>
        </label>
        <label>Nội dung
          <textarea rows="4" data-grid-cell-text></textarea>
        </label>
        <label>URL ảnh
          <input data-grid-cell-image placeholder="Dán link ảnh hoặc đường dẫn ảnh">
        </label>
        <div class="two-fields">
          <label>Mã đáp án
            <select data-grid-cell-answer>
              <option value="">Không</option>
<%# Kh?i l?p trong m?u t?o n?i dung ??ng t? danh s?ch d? li?u m?y ch?. %>
              <% answerKeys.forEach((key) => { %><option value="<%= key %>"><%= key %></option><% }) %>
            </select>
          </label>
          <label>Căn lề
            <select data-grid-cell-align>
              <option value="center">Giữa</option>
              <option value="left">Trái</option>
              <option value="right">Phải</option>
            </select>
          </label>
        </div>
        <label>Màu nền
          <input type="color" value="#ffffff" data-grid-cell-background>
        </label>
      </div>
    </div>
  </section>

  <fieldset class="choice-fieldset image-fieldset" data-advanced-panel data-author-mode-panel="fields">
    <legend>Ảnh trong đề bài</legend>
    <label>
      Thêm ảnh minh họa mới
      <input type="file" name="question_images" accept="image/png,image/jpeg,image/webp,image/gif" multiple data-preview-images>
    </label>
    <div class="two-fields">
      <label>
        Độ rộng ảnh mới (%)
        <input type="number" name="image_width_percent" min="20" max="100" value="70" data-preview-image-width>
      </label>
      <label>
        Mô tả ảnh mới
        <input name="image_alt_text" placeholder="Ví dụ: Hình minh họa" data-preview-image-alt>
      </label>
    </div>
    <%# Kh?i ?i?u ki?n trong m?u quy?t ??nh n?i dung giao di?n d?a tr?n d? li?u m?y ch?. %>
    <% if (questionImages.length > 0) { %>
      <div class="choice-existing-images">
        <span class="form-note">Ảnh đề bài hiện có, tích "Xóa" nếu muốn bỏ khi lưu:</span>
        <%# Kh?i l?p trong m?u t?o n?i dung ??ng t? danh s?ch d? li?u m?y ch?. %>
        <% questionImages.forEach((image) => { %>
          <label class="image-keep-option">
            <input type="checkbox" name="remove_question_images" value="<%= image.id || image.url %>" data-preview-remove-image>
            <span>Xóa</span>
            <span class="question-image choice-existing-image">
              <img src="<%= image.url %>" alt="<%= image.alt_text || 'Hình minh họa đề bài' %>" loading="lazy" decoding="async">
            </span>
          </label>
        <% }) %>
      </div>
    <% } %>
  </fieldset>

  <fieldset class="choice-fieldset" data-choice-panel data-author-mode-panel="fields">
    <legend>Phương án trả lời và lỗi sai thường gặp</legend>
    <%# Kh?i l?p trong m?u t?o n?i dung ??ng t? danh s?ch d? li?u m?y ch?. %>
    <% answerKeys.forEach((key) => { %>
      <%# Kh?i chu?n b? d? li?u t?o gi? tr? trung gian cho ph?n giao di?n b?n d??i. %>
      <% const choice = choiceFor(question, key); %>
      <%# Kh?i chu?n b? d? li?u t?o gi? tr? trung gian cho ph?n giao di?n b?n d??i. %>
      <% const choiceImages = Array.isArray(choice.images) ? choice.images : []; %>
      <%# Kh?i chu?n b? d? li?u t?o gi? tr? trung gian cho ph?n giao di?n b?n d??i. %>
      <% const misconception = misconceptionByKey.get(key) || {}; %>
      <div class="choice-editor">
        <label class="choice-input">
          <span><%= key %></span>
          <input name="choice_<%= key %>" value="<%= choice.text || '' %>" data-preview-choice="<%= key %>" placeholder="Nội dung đáp án <%= key %>">
        </label>
        <input type="hidden" data-preview-choice-existing-images="<%= key %>" value="<%- escapeAttribute(JSON.stringify(choiceImages)) %>">
        <%# Kh?i ?i?u ki?n trong m?u quy?t ??nh n?i dung giao di?n d?a tr?n d? li?u m?y ch?. %>
        <% if (choiceImages.length > 0) { %>
          <div class="choice-existing-images">
            <span class="form-note">Ảnh đáp án hiện có, tích "Xóa" nếu muốn bỏ khi lưu:</span>
            <%# Kh?i l?p trong m?u t?o n?i dung ??ng t? danh s?ch d? li?u m?y ch?. %>
            <% choiceImages.forEach((image) => { %>
              <label class="image-keep-option">
                <input type="checkbox" name="remove_choice_images_<%= key %>" value="<%= image.id || image.url %>" data-preview-remove-image>
                <span>Xóa</span>
                <span class="question-image choice-existing-image">
                  <img src="<%= image.url %>" alt="<%= image.alt_text || `Hình minh họa đáp án ${key}` %>" loading="lazy" decoding="async">
                </span>
              </label>
            <% }) %>
          </div>
        <% } %>
        <fieldset class="choice-fieldset image-fieldset choice-image-upload">
          <legend>Ảnh đáp án <%= key %></legend>
          <label>
            Thêm ảnh cho đáp án <%= key %>
            <input type="file" name="choice_image_<%= key %>" accept="image/png,image/jpeg,image/webp,image/gif" multiple data-preview-choice-images="<%= key %>">
          </label>
          <div class="two-fields">
            <label>
              Độ rộng ảnh mới (%)
              <input type="number" name="choice_image_width_percent_<%= key %>" min="20" max="100" value="100" data-preview-choice-image-width="<%= key %>">
            </label>
            <label>
              Mô tả ảnh mới
              <input name="choice_image_alt_text_<%= key %>" placeholder="Ví dụ: Hình minh họa đáp án <%= key %>" data-preview-choice-image-alt="<%= key %>">
            </label>
          </div>
        </fieldset>
        <div class="two-fields">
          <label>
            Tên lỗi sai <%= key %>
            <input name="misconception_name_<%= key %>" value="<%= misconception.misconception_name || '' %>" placeholder="Ví dụ: Nhầm quy tắc">
          </label>
          <label>
            Giải thích lỗi sai <%= key %>
            <input name="misconception_<%= key %>" value="<%= misconception.explanation || '' %>" placeholder="Chỉ nhập nếu <%= key %> là đáp án sai">
          </label>
        </div>
      </div>
    <% }) %>
  </fieldset>

  <label data-correct-choice-panel>
    Đáp án đúng
    <select name="correct_answer" required>
      <%# Kh?i l?p trong m?u t?o n?i dung ??ng t? danh s?ch d? li?u m?y ch?. %>
      <% answerKeys.forEach((key) => { %>
        <option value="<%= key %>" <%= selected(question.correct_answer, key) %>><%= key %></option>
      <% }) %>
    </select>
  </label>

  <label data-correct-free-panel hidden>
    Đáp án đúng
    <input name="correct_answer_free" value="<%= questionType === 'FILL_IN_THE_BLANK' ? question.correct_answer : '' %>" placeholder="Ví dụ: 15 hoặc 2/3" data-free-answer>
  </label>

  <label data-author-mode-panel="fields">
    Lời giải chi tiết
    <textarea name="explanation_text" rows="5"><%= explanationText(question) %></textarea>
  </label>

  <fieldset class="choice-fieldset image-fieldset" data-advanced-panel data-author-mode-panel="fields">
    <legend>Ảnh trong lời giải</legend>
    <label>
      Thêm ảnh minh họa lời giải
      <input type="file" name="explanation_images" accept="image/png,image/jpeg,image/webp,image/gif" multiple>
    </label>
    <div class="two-fields">
      <label>
        Độ rộng ảnh mới (%)
        <input type="number" name="explanation_image_width_percent" min="20" max="100" value="70">
      </label>
      <label>
        Mô tả ảnh mới
        <input name="explanation_image_alt_text" placeholder="Ví dụ: Hình minh họa lời giải">
      </label>
    </div>
    <%# Kh?i ?i?u ki?n trong m?u quy?t ??nh n?i dung giao di?n d?a tr?n d? li?u m?y ch?. %>
    <% if (explanationImages.length > 0) { %>
      <div class="choice-existing-images">
        <span class="form-note">Ảnh lời giải hiện có, tích "Xóa" nếu muốn bỏ khi lưu:</span>
        <%# Kh?i l?p trong m?u t?o n?i dung ??ng t? danh s?ch d? li?u m?y ch?. %>
        <% explanationImages.forEach((image) => { %>
          <label class="image-keep-option">
            <input type="checkbox" name="remove_explanation_images" value="<%= image.id || image.url %>">
            <span>Xóa</span>
            <span class="question-image choice-existing-image">
              <img src="<%= image.url %>" alt="<%= image.alt_text || 'Hình minh họa lời giải' %>" loading="lazy" decoding="async">
            </span>
          </label>
        <% }) %>
      </div>
    <% } %>
  </fieldset>

  <aside class="question-form-preview" data-author-mode-panel="fields">
    <div class="section-title">
      <i data-lucide="eye" class="lucide-icon"></i>
      Preview sau khi sửa
    </div>
    <div class="question-preview-box math-content" data-question-preview></div>
    <div class="placeholder-list" data-preview-placeholder-list hidden></div>
  </aside>

  <div class="form-actions">
    <button class="btn btn-secondary" type="button" data-close-details>Hủy</button>
    <button class="btn btn-primary" type="submit">
      <i data-lucide="save" class="lucide-icon"></i>
      Lưu thay đổi
    </button>
  </div>
</form>
