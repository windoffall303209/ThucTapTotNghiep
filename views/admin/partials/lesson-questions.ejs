<%# M?u giao di?n lesson questions k?t h?p d? li?u m?y ch? v?i HTML ?? hi?n th? m?t m?n h?nh c?a ?ng d?ng. %>
<%
  const answerKeys = ['A', 'B', 'C', 'D'];
  const difficultyOptions = [
    { value: 'EASY', label: 'Dễ' },
    { value: 'MEDIUM', label: 'Trung bình' },
    { value: 'HARD', label: 'Khó' },
    { value: 'EXPERT', label: 'Nâng cao' }
  ];
  const layoutOptions = [
    { value: 'STACK_VERTICAL', label: 'Chữ và ảnh theo thứ tự' },
    { value: 'VISUAL_TOP', label: 'Ảnh lớn phía trên' },
    { value: 'VISUAL_BOTTOM', label: 'Ảnh phía dưới' },
    { value: 'SPLIT_HORIZONTAL_LEFT_IMAGE', label: 'Ảnh trái, chữ phải' },
    { value: 'SPLIT_HORIZONTAL_RIGHT_IMAGE', label: 'Chữ trái, ảnh phải' },
    { value: 'IMAGE_IN_CHOICES', label: 'Ảnh trong đáp án' },
    { value: 'COMPACT', label: 'Gọn nhẹ' }
  ];
  const pageInfo = typeof pagination !== 'undefined'
    ? pagination
    : { page: 1, totalPages: 1, total: questions.length, limit: questions.length || 20 };

  function escapeHtml(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function escapeAttribute(value) {
    return escapeHtml(value).replace(/`/g, '&#096;');
  }

  function choiceFor(question, key) {
    return (question.choices || []).find((item) => item.key === key) || { key, text: '', images: [] };
  }

  function imageHtml(image) {
    const width = Math.min(Math.max(Number(image.width_percent || image.width || 100), 20), 100);
    return `
      <span class="question-image" style="max-width:${width}%">
        <img src="${escapeAttribute(image.url || '')}" alt="${escapeAttribute(image.alt_text || image.alt || 'Hình minh họa')}" loading="lazy" decoding="async">
      </span>
    `;
  }

  function imageGroupHtml(images) {
    if (!Array.isArray(images) || images.length === 0) return '';
    return `<div class="saved-question-images">${images.map(imageHtml).join('')}</div>`;
  }

  function gridRenderHtml(grid) {
    if (!grid || !grid.enabled) return '';
    return `<div class="content-grid-render math-content" data-grid-render="${escapeAttribute(JSON.stringify(grid))}"></div>`;
  }

  function hasGridAnswers(question) {
    const cells = question.content?.grid_layout?.cells || [];
    return cells.some((cell) => cell.type === 'answer' || cell.type === 'free_answer_input');
  }

  function displayLayout(question) {
    return question.content?.layout_variant || question.layout_template || 'STACK_VERTICAL';
  }

  // Dịch mã thô ra tiếng Việt ở chế độ XEM. Danh sách nhãn đã có sẵn cho các ô
  // select của form soạn; chế độ xem trước đây lại in thẳng EASY hay
  // STACK_VERTICAL khiến người rà soát phải tự thuộc bảng mã.
  function difficultyLabel(question) {
    const value = question.difficulty || 'EASY';
    return (difficultyOptions.find((option) => option.value === value) || {}).label || value;
  }

  function layoutLabel(question) {
    const value = displayLayout(question);
    return (layoutOptions.find((option) => option.value === value) || {}).label || value;
  }

  function questionTypeLabel(question) {
    return question.question_type === 'FILL_IN_THE_BLANK' ? 'Điền đáp án' : 'Trắc nghiệm';
  }

  function savedQuestionLayoutClass(question) {
    const map = {
      STACK_VERTICAL: 'layout-stack',
      VISUAL_TOP: 'layout-visual-top',
      VISUAL_BOTTOM: 'layout-visual-bottom',
      SPLIT_HORIZONTAL_LEFT_IMAGE: 'layout-image-left',
      SPLIT_HORIZONTAL_RIGHT_IMAGE: 'layout-image-right',
      IMAGE_IN_CHOICES: 'layout-image-choices',
      COMPACT: 'layout-compact'
    };
    return map[displayLayout(question)] || 'layout-stack';
  }

  function stripImagePlaceholders(text, images) {
    let value = String(text || '');
    (images || []).forEach((image) => {
      if (image.id) value = value.replaceAll(`[${image.id}]`, '');
    });
    return value;
  }

  function contentHtml(question, options = {}) {
    const content = question.content || {};
    const images = Array.isArray(content.images) ? content.images : [];
    const layout = displayLayout(question);
    const gridHtml = gridRenderHtml(content.grid_layout);
    let rawText = ['VISUAL_TOP', 'VISUAL_BOTTOM', 'SPLIT_HORIZONTAL_LEFT_IMAGE', 'SPLIT_HORIZONTAL_RIGHT_IMAGE'].includes(layout)
      ? stripImagePlaceholders(content.text, images)
      : String(content.text || '');

    let html = escapeHtml(rawText).replace(/\r?\n/g, '<br>');
    images.forEach((image) => {
      html = html.replaceAll(`[${escapeHtml(image.id)}]`, imageHtml(image));
    });
    const imageGroup = imageGroupHtml(images);

    if (layout === 'VISUAL_TOP') return `${gridHtml}${imageGroup}<div class="saved-question-text">${html}</div>`;
    if (layout === 'VISUAL_BOTTOM') return `${gridHtml}<div class="saved-question-text">${html}</div>${imageGroup}`;
    if (layout === 'SPLIT_HORIZONTAL_LEFT_IMAGE') return `${gridHtml}${imageGroup}<div class="saved-question-text">${html}</div>`;
    if (layout === 'SPLIT_HORIZONTAL_RIGHT_IMAGE') return `${gridHtml}<div class="saved-question-text">${html}</div>${imageGroup}`;

    const missingImages = options.appendMissingImages === false
      ? ''
      : images
          .filter((image) => !String(content.text || '').includes(`[${image.id}]`))
          .map(imageHtml)
          .join('');

    return `${gridHtml}${html}${missingImages}`;
  }

  function explanationHtml(question) {
    const explanation = question.explanation || {};
    const images = Array.isArray(explanation.images) ? explanation.images : [];
    const text = explanation.text ? escapeHtml(explanation.text).replace(/\r?\n/g, '<br>') : '';
    if (images.length === 0 && !text) return '';
    return `
      <div class="saved-explanation math-content math-lazy">
        <strong>Lời giải:</strong>
        ${imageGroupHtml(images)}
        ${text ? `<div class="saved-question-text">${text}</div>` : ''}
      </div>
    `;
  }
%>

<div class="lesson-content-toolbar">
  <p><strong><%= pageInfo.total %></strong> câu hỏi · Trang <%= pageInfo.page %>/<%= pageInfo.totalPages %></p>
  <span>Bài #<%= lesson.id %></span>
</div>

<details class="inline-create-panel">
  <summary>
    <i data-lucide="plus" class="lucide-icon"></i>
    Thêm câu hỏi mới
  </summary>
  <form class="question-create-inline stack-form" action="/admin/questions" method="post" enctype="multipart/form-data" data-question-preview-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="lesson_id" value="<%= lesson.id %>" required>

    <div class="form-actions form-actions-top">
      <button class="btn btn-secondary" type="button" data-close-details>Hủy</button>
      <button class="btn btn-primary" type="submit">
        <i data-lucide="save" class="lucide-icon"></i>
        Lưu câu hỏi
      </button>
    </div>

    <input type="hidden" name="authoring_mode" value="fields" data-authoring-mode-input>
    <div class="authoring-mode-switch" data-authoring-mode>
      <label>
        <input type="radio" name="authoring_mode_choice_question_<%= lesson.id %>" value="fields" checked>
        Nhập từng trường
      </label>
      <label>
        <input type="radio" name="authoring_mode_choice_question_<%= lesson.id %>" value="canvas">
        Thiết kế bằng canvas
      </label>
    </div>

    <div class="two-fields">
      <label>
        Dạng câu hỏi
        <select name="question_type" data-question-type>
          <option value="MULTIPLE_CHOICE">Trắc nghiệm A/B/C/D</option>
          <option value="FILL_IN_THE_BLANK">Điền đáp án</option>
        </select>
      </label>
      <label data-author-mode-panel="fields">
        Bố cục hiển thị
        <select name="layout_variant" data-layout-variant>
          <%# Kh?i l?p trong m?u t?o n?i dung ??ng t? danh s?ch d? li?u m?y ch?. %>
          <% layoutOptions.forEach((option) => { %>
            <option value="<%= option.value %>"><%= option.label %></option>
          <% }) %>
        </select>
      </label>
    </div>

    <div class="two-fields">
      <label>
        Độ khó
        <select name="difficulty">
          <%# Kh?i l?p trong m?u t?o n?i dung ??ng t? danh s?ch d? li?u m?y ch?. %>
          <% difficultyOptions.forEach((option) => { %>
            <option value="<%= option.value %>"><%= option.label %></option>
          <% }) %>
        </select>
      </label>
      <label data-author-mode-panel="fields">
        Kiểu thao tác
        <select name="question_interaction" data-question-interaction>
          <option value="choose">Chọn đáp án</option>
          <option value="fill_blank">Điền số/kết quả</option>
          <option value="count">Đếm hình</option>
          <option value="compare">So sánh</option>
          <option value="none">Không phân loại</option>
        </select>
      </label>
    </div>

    <label data-author-mode-panel="fields">
      Đề bài
      <textarea name="content_text" rows="5" placeholder="Ví dụ: Tính $\\frac{1}{3}+\\frac{2}{5}$." data-preview-content></textarea>
    </label>

    <input type="hidden" name="grid_layout" value="<%- escapeAttribute(JSON.stringify({ enabled: false, rows: 5, columns: 5, cells: [] })) %>" data-grid-layout-input>
    <section class="grid-editor" data-grid-editor data-grid-mode="question" data-author-mode-panel="canvas" hidden>
      <div class="grid-editor-head">
        <label class="toggle-line">
          <input type="checkbox" data-grid-enabled>
          Dùng thiết kế dạng lưới
        </label>
        <div class="grid-size-controls">
          <label>Dòng <input type="number" min="1" max="10" value="5" data-grid-rows></label>
          <label>Cột <input type="number" min="1" max="10" value="5" data-grid-columns></label>
        </div>
      </div>
      <div class="grid-editor-actions">
        <button class="btn btn-secondary btn-compact" type="button" data-grid-merge>Gộp ô</button>
        <button class="btn btn-secondary btn-compact" type="button" data-grid-unmerge>Tách ô</button>
        <button class="btn btn-secondary btn-compact" type="button" data-grid-clear>Để trống ô</button>
      </div>
      <div class="grid-editor-workspace">
        <div class="grid-editor-canvas" data-grid-canvas></div>
        <div class="grid-cell-panel">
          <div class="form-note">Chọn hoặc kéo qua nhiều ô, sau đó gán nội dung cho vùng đang chọn.</div>
          <label>Loại ô
            <select data-grid-cell-type>
              <option value="text">Chữ</option>
              <option value="question_text">Đề bài</option>
              <option value="image">Ảnh</option>
              <option value="formula">Công thức</option>
              <option value="answer">Đáp án chọn</option>
              <option value="free_answer_input">Ô điền đáp án</option>
              <option value="solution">Lời giải</option>
              <option value="instruction">Hướng dẫn</option>
              <option value="empty">Để trống</option>
            </select>
          </label>
          <label>Nội dung
            <textarea rows="4" data-grid-cell-text></textarea>
          </label>
          <label>URL ảnh
            <input data-grid-cell-image placeholder="Dán link ảnh hoặc đường dẫn ảnh">
          </label>
          <div class="two-fields">
            <label>Mã đáp án
              <select data-grid-cell-answer>
                <option value="">Không</option>
<%# Kh?i l?p trong m?u t?o n?i dung ??ng t? danh s?ch d? li?u m?y ch?. %>
                <% answerKeys.forEach((key) => { %><option value="<%= key %>"><%= key %></option><% }) %>
              </select>
            </label>
            <label>Căn lề
              <select data-grid-cell-align>
                <option value="center">Giữa</option>
                <option value="left">Trái</option>
                <option value="right">Phải</option>
              </select>
            </label>
          </div>
          <label>Màu nền
            <input type="color" value="#ffffff" data-grid-cell-background>
          </label>
        </div>
      </div>
    </section>

    <fieldset class="choice-fieldset image-fieldset" data-advanced-panel data-author-mode-panel="fields">
      <legend>Ảnh trong đề bài</legend>
      <label>
        Ảnh minh họa
        <input type="file" name="question_images" accept="image/png,image/jpeg,image/webp,image/gif" multiple data-preview-images>
      </label>
      <div class="two-fields">
        <label>
          Độ rộng ảnh (%)
          <input type="number" name="image_width_percent" min="20" max="100" value="70" data-preview-image-width>
        </label>
        <label>
          Mô tả ảnh
          <input name="image_alt_text" placeholder="Ví dụ: Hình tam giác ABC" data-preview-image-alt>
        </label>
      </div>
    </fieldset>

    <fieldset class="choice-fieldset" data-choice-panel data-author-mode-panel="fields">
      <legend>Phương án trả lời và lỗi sai thường gặp</legend>
      <%# Kh?i l?p trong m?u t?o n?i dung ??ng t? danh s?ch d? li?u m?y ch?. %>
      <% answerKeys.forEach((key) => { %>
        <div class="choice-editor">
          <label class="choice-input">
            <span><%= key %></span>
            <input name="choice_<%= key %>" data-preview-choice="<%= key %>" placeholder="Nội dung đáp án <%= key %>">
          </label>
          <fieldset class="choice-fieldset image-fieldset choice-image-upload">
            <legend>Ảnh đáp án <%= key %></legend>
            <label>
              Ảnh minh họa đáp án <%= key %>
              <input type="file" name="choice_image_<%= key %>" accept="image/png,image/jpeg,image/webp,image/gif" multiple data-preview-choice-images="<%= key %>">
            </label>
            <div class="two-fields">
              <label>
                Độ rộng ảnh (%)
                <input type="number" name="choice_image_width_percent_<%= key %>" min="20" max="100" value="100" data-preview-choice-image-width="<%= key %>">
              </label>
              <label>
                Mô tả ảnh
                <input name="choice_image_alt_text_<%= key %>" placeholder="Ví dụ: Hình minh họa đáp án <%= key %>" data-preview-choice-image-alt="<%= key %>">
              </label>
            </div>
          </fieldset>
          <div class="two-fields">
            <label>
              Tên lỗi sai <%= key %>
              <input name="misconception_name_<%= key %>" placeholder="Ví dụ: Cộng cả tử và mẫu">
            </label>
            <label>
              Giải thích lỗi sai <%= key %>
              <input name="misconception_<%= key %>" placeholder="Chỉ dùng khi <%= key %> là đáp án sai">
            </label>
          </div>
        </div>
      <% }) %>
    </fieldset>

    <label data-correct-choice-panel>
      Đáp án đúng
      <select name="correct_answer" required>
        <option value="">Chọn đáp án</option>
        <%# Kh?i l?p trong m?u t?o n?i dung ??ng t? danh s?ch d? li?u m?y ch?. %>
        <% answerKeys.forEach((key) => { %>
          <option value="<%= key %>"><%= key %></option>
        <% }) %>
      </select>
    </label>

    <label data-correct-free-panel hidden>
      Đáp án đúng
      <input name="correct_answer_free" placeholder="Ví dụ: 15 hoặc 2/3" data-free-answer>
    </label>

    <label data-author-mode-panel="fields">
      Lời giải chi tiết
      <textarea name="explanation_text" rows="4" placeholder="Giải thích từng bước cho học sinh."></textarea>
    </label>

    <fieldset class="choice-fieldset image-fieldset" data-advanced-panel data-author-mode-panel="fields">
      <legend>Ảnh trong lời giải</legend>
      <label>
        Ảnh minh họa lời giải
        <input type="file" name="explanation_images" accept="image/png,image/jpeg,image/webp,image/gif" multiple>
      </label>
      <div class="two-fields">
        <label>
          Độ rộng ảnh (%)
          <input type="number" name="explanation_image_width_percent" min="20" max="100" value="70">
        </label>
        <label>
          Mô tả ảnh
          <input name="explanation_image_alt_text" placeholder="Ví dụ: Hình minh họa lời giải">
        </label>
      </div>
    </fieldset>

    <aside class="question-form-preview" data-author-mode-panel="fields">
      <div class="section-title">
        <i data-lucide="eye" class="lucide-icon"></i>
        Preview học sinh nhìn thấy
      </div>
      <div class="question-preview-box math-content" data-question-preview></div>
      <div class="placeholder-list" data-preview-placeholder-list hidden></div>
    </aside>

    <div class="form-actions">
      <button class="btn btn-secondary" type="button" data-close-details>Hủy</button>
      <button class="btn btn-primary" type="submit">
        <i data-lucide="save" class="lucide-icon"></i>
        Lưu câu hỏi
      </button>
    </div>
  </form>
</details>

<%
  const boLoc = typeof filters === 'object' && filters !== null ? filters : { difficulty: '', keyword: '' };
  const dangLoc = Boolean(boLoc.difficulty || boLoc.keyword);
%>
<%# Lọc ngay trong một bài theo độ khó và từ khóa: bài 30-40 câu mà chỉ lật
    trang tuần tự thì tìm một câu cụ thể rất mất thời gian. Form này do JS bắt
    submit và tải lại partial với tham số lọc, giữ nguyên cơ chế nạp động. %>
<form class="question-filter-bar" data-question-filter>
  <label>
    Độ khó
    <select name="difficulty">
      <option value="">Tất cả</option>
      <%# Kh?i l?p trong m?u t?o n?i dung ??ng t? danh s?ch d? li?u m?y ch?. %>
      <% difficultyOptions.forEach((option) => { %>
        <option value="<%= option.value %>" <%= boLoc.difficulty === option.value ? 'selected' : '' %>><%= option.label %></option>
      <% }) %>
    </select>
  </label>
  <label>
    Từ khóa trong đề bài
    <input type="search" name="q" value="<%= boLoc.keyword %>" placeholder="Ví dụ: quả cam...">
  </label>
  <button class="btn btn-secondary btn-compact" type="submit">
    <i data-lucide="filter" class="lucide-icon"></i>
    Lọc
  </button>
  <%# Kh?i ?i?u ki?n trong m?u quy?t ??nh n?i dung giao di?n d?a tr?n d? li?u m?y ch?. %>
  <% if (dangLoc) { %>
    <button class="btn btn-secondary btn-compact" type="button" data-question-filter-clear>
      Bỏ lọc
    </button>
  <% } %>
</form>

<%# Kh?i ?i?u ki?n trong m?u quy?t ??nh n?i dung giao di?n d?a tr?n d? li?u m?y ch?. %>
<% if (questions.length === 0) { %>
  <div class="empty-state compact">
    <%= dangLoc
      ? 'Không có câu hỏi nào khớp bộ lọc trong bài này. Bấm "Bỏ lọc" để xem lại toàn bộ.'
      : 'Bài này chưa có câu hỏi. Bấm "Thêm câu hỏi mới" để nhập câu hỏi đầu tiên.' %>
  </div>
<% } %>

<%# Kh?i ?i?u ki?n trong m?u quy?t ??nh n?i dung giao di?n d?a tr?n d? li?u m?y ch?. %>
<% if (pageInfo.totalPages > 1) { %>
  <nav class="question-pagination" aria-label="Phân trang câu hỏi">
    <button class="btn btn-secondary btn-compact" type="button" data-question-page="<%= pageInfo.page - 1 %>" <%= pageInfo.page <= 1 ? 'disabled' : '' %>>
      <i data-lucide="chevron-left" class="lucide-icon"></i>
      Trước
    </button>
    <span>Trang <strong><%= pageInfo.page %></strong>/<%= pageInfo.totalPages %> · <%= pageInfo.total %> câu hỏi</span>
    <button class="btn btn-secondary btn-compact" type="button" data-question-page="<%= pageInfo.page + 1 %>" <%= pageInfo.page >= pageInfo.totalPages ? 'disabled' : '' %>>
      Sau
      <i data-lucide="chevron-right" class="lucide-icon"></i>
    </button>
  </nav>
<% } %>

<div class="bank-question-list">
  <%# Kh?i l?p trong m?u t?o n?i dung ??ng t? danh s?ch d? li?u m?y ch?. %>
  <% questions.forEach((question) => { %>
    <%# Kh?i chu?n b? d? li?u t?o gi? tr? trung gian cho ph?n giao di?n b?n d??i. %>
    <% const hasSupportingContent = question.question_type !== 'FILL_IN_THE_BLANK' || Boolean(question.explanation?.text) || (question.explanation?.images || []).length > 0; %>
    <article class="bank-question">
      <div class="bank-question-head">
        <div>
          <div class="bank-question-meta">
            <span>ID #<%= question.id %></span>
            <span><%= questionTypeLabel(question) %></span>
            <span><%= difficultyLabel(question) %></span>
            <span><%= layoutLabel(question) %></span>
          </div>
          <div class="saved-question-layout <%= savedQuestionLayoutClass(question) %> math-content math-lazy">
            <%- contentHtml(question) %>
          </div>
        </div>
        <span class="answer-badge">Đáp án <%= question.correct_answer %></span>
      </div>

      <%# Kh?i ?i?u ki?n trong m?u quy?t ??nh n?i dung giao di?n d?a tr?n d? li?u m?y ch?. %>
      <% if (hasSupportingContent) { %>
        <details class="record-support">
          <summary>Đáp án và lời giải</summary>
          <div class="record-support-content">
            <%# Kh?i ?i?u ki?n trong m?u quy?t ??nh n?i dung giao di?n d?a tr?n d? li?u m?y ch?. %>
            <% if (question.question_type !== 'FILL_IN_THE_BLANK' && !hasGridAnswers(question)) { %>
              <div class="question-choice-list math-content math-lazy <%= displayLayout(question) === 'IMAGE_IN_CHOICES' ? 'answer-grid-image-choices' : '' %>">
                <%# Kh?i l?p trong m?u t?o n?i dung ??ng t? danh s?ch d? li?u m?y ch?. %>
                <% answerKeys.forEach((key) => { %>
                  <%# Kh?i chu?n b? d? li?u t?o gi? tr? trung gian cho ph?n giao di?n b?n d??i. %>
                  <% const choice = choiceFor(question, key); %>
                  <div class="<%= question.correct_answer === key ? 'is-correct' : '' %>">
                    <span><%= key %></span>
                    <div class="choice-body">
                      <strong><%= choice.text || 'Đáp án bằng hình ảnh' %></strong>
                      <%- imageGroupHtml(choice.images || []) %>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
            <%- explanationHtml(question) %>
          </div>
        </details>
      <% } %>

      <div class="question-actions">
        <details class="inline-edit-panel">
          <summary>
            <i data-lucide="pencil" class="lucide-icon"></i>
            Sửa câu hỏi
          </summary>
          <div class="question-edit-shell" data-question-edit-shell data-question-id="<%= question.id %>">
            <div class="empty-state compact">Mở phần sửa để tải form chỉnh sửa câu hỏi.</div>
          </div>
        </details>

        <%# Nhân bản: tạo bản sao trong cùng bài để soạn loạt câu cùng khuôn,
            đề bản sao được đánh dấu "cần sửa lại" để không quên hai câu trùng. %>
        <form action="/admin/questions/<%= question.id %>/duplicate" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="lesson_id" value="<%= lesson.id %>">
          <button class="btn btn-secondary btn-compact" type="submit">
            <i data-lucide="copy" class="lucide-icon"></i>
            Nhân bản
          </button>
        </form>

        <%# data-confirm thay cho onsubmit inline: cả trang admin dùng chung một
            cơ chế xác nhận trong app.js, không rải confirm() thủ công mỗi nơi
            một kiểu. %>
        <form
          class="delete-question-form"
          action="/admin/questions/<%= question.id %>/delete"
          method="post"
          data-confirm="Bạn chắc chắn muốn xóa câu hỏi này? Lịch sử làm bài liên quan tới câu hỏi này cũng có thể bị ảnh hưởng.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="lesson_id" value="<%= lesson.id %>">
          <button class="btn btn-danger btn-compact" type="submit">
            <i data-lucide="trash-2" class="lucide-icon"></i>
            Xóa
          </button>
        </form>
      </div>
    </article>
  <% }) %>
</div>
