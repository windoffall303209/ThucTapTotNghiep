<section class="workspace-head">
  <div>
    <p class="eyebrow">Quản trị nội dung</p>
    <h1>Tổng quan hệ thống</h1>
    <p>Theo dõi dữ liệu nền tảng, kiểm tra ngân hàng câu hỏi và đi nhanh tới các khu vực cần quản lý.</p>
  </div>
  <div class="row-actions">
    <a class="btn btn-secondary" href="/admin/theory">
      <i data-lucide="book-open" class="lucide-icon"></i>
      Kho lý thuyết
    </a>
    <a class="btn btn-primary" href="/admin/questions">
      <i data-lucide="plus" class="lucide-icon"></i>
      Thêm câu hỏi
    </a>
  </div>
</section>

<section class="admin-metrics">
  <div>
    <span><%= stats.questionCount %></span>
    <small>Câu hỏi trong ngân hàng</small>
  </div>
  <div>
    <span><%= stats.lessonCount %></span>
    <small>Bài học có câu hỏi</small>
  </div>
  <div>
    <span><%= stats.studentCount %></span>
    <small>Học sinh đã đăng ký</small>
  </div>
  <div>
    <span><%= stats.easyCount %></span>
    <small>Câu mức dễ</small>
  </div>
</section>

<%
  const tongCau = Math.max(
    Number(difficultyStats.EASY) + Number(difficultyStats.MEDIUM)
      + Number(difficultyStats.HARD) + Number(difficultyStats.EXPERT),
    1
  );
  const mucDoKho = [
    { key: 'EASY', label: 'Dễ' },
    { key: 'MEDIUM', label: 'Trung bình' },
    { key: 'HARD', label: 'Khó' },
    { key: 'EXPERT', label: 'Nâng cao' }
  ];
%>
<section class="admin-dashboard-grid">
  <div class="dashboard-panel difficulty-panel">
    <div class="section-title">
      <i data-lucide="bar-chart-3" class="lucide-icon"></i>
      Phân bố độ khó ngân hàng câu hỏi
    </div>
    <div class="difficulty-bars" aria-label="Bảng phân bố câu hỏi theo độ khó">
      <% mucDoKho.forEach((muc) => { %>
        <% const soCau = Number(difficultyStats[muc.key] || 0); %>
        <% const phanTram = Math.round((soCau / tongCau) * 100); %>
        <div class="difficulty-row">
          <span class="difficulty-label"><%= muc.label %></span>
          <div
            class="difficulty-track"
            role="progressbar"
            aria-valuenow="<%= phanTram %>"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-label="<%= muc.label %>: <%= soCau %> câu, chiếm <%= phanTram %> phần trăm">
            <span style="width: <%= phanTram %>%"></span>
          </div>
          <strong class="difficulty-value"><%= soCau %> · <%= phanTram %>%</strong>
        </div>
      <% }) %>
    </div>
  </div>
  <div class="dashboard-panel backlog-panel">
    <div class="section-title">
      <i data-lucide="alert-circle" class="lucide-icon"></i>
      Việc tồn đọng
    </div>
    <%# Hai con số người soạn nội dung cần thấy đầu tiên: bài nào còn trống.
        Bấm vào là sang thẳng trang biên soạn của bài đó. %>
    <% if (backlog.thieuCauHoi === 0 && backlog.thieuLyThuyet === 0) { %>
      <p class="muted">Mọi bài học đều đã có câu hỏi và lý thuyết. Không còn việc tồn đọng.</p>
    <% } else { %>
      <% if (backlog.thieuCauHoi > 0) { %>
        <p class="muted"><strong><%= backlog.thieuCauHoi %></strong> bài chưa có câu hỏi nào:</p>
        <div class="row-actions">
          <% backlog.viDuThieuCauHoi.forEach((lesson) => { %>
            <a class="status-pill status-review" href="/admin/questions?lesson=<%= lesson.id %>" title="Soạn câu hỏi cho bài này">
              <%= lesson.lesson_name %>
            </a>
          <% }) %>
          <% if (backlog.thieuCauHoi > 5) { %><span class="status-pill status-new">+<%= backlog.thieuCauHoi - 5 %> bài nữa</span><% } %>
        </div>
      <% } %>
      <% if (backlog.thieuLyThuyet > 0) { %>
        <p class="muted"><strong><%= backlog.thieuLyThuyet %></strong> bài chưa có thẻ lý thuyết:</p>
        <div class="row-actions">
          <% backlog.viDuThieuLyThuyet.forEach((lesson) => { %>
            <a class="status-pill status-review" href="/admin/theory?lesson=<%= lesson.id %>" title="Soạn lý thuyết cho bài này">
              <%= lesson.lesson_name %>
            </a>
          <% }) %>
          <% if (backlog.thieuLyThuyet > 5) { %><span class="status-pill status-new">+<%= backlog.thieuLyThuyet - 5 %> bài nữa</span><% } %>
        </div>
      <% } %>
    <% } %>
  </div>
</section>

<section class="quick-grid">
  <a class="action-card" href="/admin/questions">
    <i data-lucide="list-checks" class="feature-icon"></i>
    <strong>Quản lý câu hỏi</strong>
    <p class="muted">Chọn sách, chương, bài để thêm/sửa câu hỏi và lời giải.</p>
  </a>
  <a class="action-card" href="/admin/theory">
    <i data-lucide="book-open" class="feature-icon"></i>
    <strong>Quản lý lý thuyết</strong>
    <p class="muted">Cập nhật thẻ kiến thức, ví dụ và ảnh minh họa cho từng bài.</p>
  </a>
  <% if (admin.role === 'SYSADMIN') { %>
    <a class="action-card" href="/admin/settings">
      <i data-lucide="settings" class="feature-icon"></i>
      <strong>Cấu hình AI/API</strong>
      <p class="muted">Kiểm tra provider AI, timeout và lưu trữ ảnh.</p>
    </a>
  <% } %>
</section>

<%
  // Dịch mã độ khó ra tiếng Việt ở chế độ xem, đồng bộ với nhãn trong form soạn.
  const difficultyLabels = { EASY: 'Dễ', MEDIUM: 'Trung bình', HARD: 'Khó', EXPERT: 'Nâng cao' };
%>
<section class="table-section">
  <div class="section-title">
    <i data-lucide="list-checks" class="lucide-icon"></i>
    Câu hỏi gần đây
  </div>
  <% if (!questions || questions.length === 0) { %>
    <div class="empty-state compact">
      <p>Chưa có câu hỏi nào trong ngân hàng. Vào "Ngân hàng câu hỏi" để soạn câu đầu tiên.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Bài học</th>
            <th>Độ khó</th>
            <th>Đáp án</th>
            <th>Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% questions.forEach((question) => { %>
            <tr>
              <td>#<%= question.id %></td>
              <td><%= question.lesson_name %></td>
              <td><span class="status-pill status-new"><%= difficultyLabels[question.difficulty] || question.difficulty %></span></td>
              <td><span class="answer-badge"><%= question.correct_answer %></span></td>
              <td>
                <%# Link thẳng sang bài chứa câu này để sửa, thay vì bắt admin tự
                    mò qua menu Ngân hàng câu hỏi rồi tìm lại. %>
                <a class="btn btn-secondary btn-compact" href="/admin/questions?lesson=<%= question.lesson_id %>">
                  <i data-lucide="pencil" class="lucide-icon"></i>
                  Mở bài để sửa
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<% if (typeof pageStyles !== 'undefined') pageStyles.push('/css/admin/dashboard.css'); %>
