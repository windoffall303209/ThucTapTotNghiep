<section class="workspace-head">
  <div>
    <p class="eyebrow">Quản trị nội dung</p>
    <h1>Tổng quan hệ thống</h1>
    <p>Theo dõi dữ liệu nền tảng, kiểm tra ngân hàng câu hỏi và đi nhanh tới các khu vực cần quản lý.</p>
  </div>
  <div class="row-actions">
    <a class="btn btn-secondary" href="/admin/theory">
      <i data-lucide="book-open" class="lucide-icon"></i>
      Kho lý thuyết
    </a>
    <a class="btn btn-primary" href="/admin/questions">
      <i data-lucide="plus" class="lucide-icon"></i>
      Thêm câu hỏi
    </a>
  </div>
</section>

<section class="admin-metrics">
  <div>
    <span><%= stats.questionCount %></span>
    <small>Câu hỏi trong ngân hàng</small>
  </div>
  <div>
    <span><%= stats.lessonCount %></span>
    <small>Bài học có câu hỏi</small>
  </div>
  <div>
    <span><%= stats.studentCount %></span>
    <small>Học sinh đã đăng ký</small>
  </div>
  <div>
    <span><%= stats.easyCount %></span>
    <small>Câu mức dễ</small>
  </div>
</section>

<section class="quick-grid">
  <a class="action-card" href="/admin/questions">
    <i data-lucide="list-checks" class="feature-icon"></i>
    <strong>Quản lý câu hỏi</strong>
    <p class="muted">Chọn sách, chương, bài để thêm/sửa câu hỏi và lời giải.</p>
  </a>
  <a class="action-card" href="/admin/theory">
    <i data-lucide="book-open" class="feature-icon"></i>
    <strong>Quản lý lý thuyết</strong>
    <p class="muted">Cập nhật thẻ kiến thức, ví dụ và ảnh minh họa cho từng bài.</p>
  </a>
  <% if (admin.role === 'SYSADMIN') { %>
    <a class="action-card" href="/admin/settings">
      <i data-lucide="settings" class="feature-icon"></i>
      <strong>Cấu hình AI/API</strong>
      <p class="muted">Kiểm tra provider AI, timeout và lưu trữ ảnh.</p>
    </a>
  <% } %>
</section>

<section class="table-section">
  <div class="section-title">
    <i data-lucide="list-checks" class="lucide-icon"></i>
    Câu hỏi gần đây
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Bài học</th>
          <th>Độ khó</th>
          <th>Đáp án</th>
        </tr>
      </thead>
      <tbody>
        <% questions.forEach((question) => { %>
          <tr>
            <td>#<%= question.id %></td>
            <td><%= question.lesson_name %></td>
            <td><span class="status-pill status-new"><%= question.difficulty %></span></td>
            <td><span class="answer-badge"><%= question.correct_answer %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
