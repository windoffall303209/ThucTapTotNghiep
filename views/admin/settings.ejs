<%
  const openaiChatModels = [
    'gpt-4.1', 'gpt-4.1-mini', 'gpt-4.1-nano',
    'gpt-4o', 'gpt-4o-mini',
    'o4-mini', 'o3-mini', 'o3'
  ];
  const geminiModels = [
    'gemini-2.5-pro', 'gemini-2.5-flash', 'gemini-2.5-flash-lite',
    'gemini-2.0-flash', 'gemini-2.0-flash-lite',
    'gemini-1.5-pro', 'gemini-1.5-flash'
  ];
  const geminiCliModels = [
    'gemini-2.5-pro', 'gemini-2.5-flash', 'gemini-2.5-flash-lite',
    'gemini-2.0-flash', 'gemini-1.5-flash'
  ];
  const nvidiaChatModels = [
    'meta/llama-3.3-70b-instruct',
    'meta/llama-3.1-405b-instruct',
    'meta/llama-3.1-70b-instruct',
    'meta/llama-3.1-8b-instruct',
    'mistralai/mixtral-8x7b-instruct-v0.1',
    'mistralai/mistral-7b-instruct-v0.3',
    'nvidia/llama-3.1-nemotron-70b-instruct'
  ];
  const openrouterModels = [
    'openai/gpt-4.1', 'openai/gpt-4.1-mini', 'openai/gpt-4o', 'openai/gpt-4o-mini',
    'anthropic/claude-3.7-sonnet', 'anthropic/claude-3.5-sonnet',
    'google/gemini-2.5-pro', 'google/gemini-2.0-flash-001',
    'meta-llama/llama-3.3-70b-instruct',
    'deepseek/deepseek-chat'
  ];

  // Che secret khi cần nhắc admin là key đã tồn tại. Tuyệt đối không đưa
  // nguyên văn key vào HTML (kể cả trong placeholder): View Source hoặc một
  // người đứng sau lưng là đọc được key thật.
  function maskSecret(value) {
    const trimmed = String(value || '').trim();
    if (!trimmed) return '';
    return `••••${trimmed.slice(-4)}`;
  }

  const providerOptions = [
    { value: 'mock', label: 'Mock (giả lập nội bộ, không gọi API)' },
    { value: 'openai', label: 'OpenAI' },
    { value: 'gemini', label: 'Gemini API' },
    { value: 'gemini_cli', label: 'Gemini CLI (OAuth local)' },
    { value: 'nvidia', label: 'NVIDIA NIM' },
    { value: 'openrouter', label: 'OpenRouter' }
  ];
%>

<section class="workspace-head">
  <div>
    <p class="eyebrow">Cấu hình hệ thống</p>
    <h1>Gợi ý học tập & lưu trữ ảnh</h1>
    <p>Quản lý provider gợi ý, policy sử dụng, timeout xử lý và Cloudinary. Secret đang được mask; để trống nếu muốn giữ giá trị cũ.</p>
  </div>
</section>

<section class="settings-page">
  <form class="settings-panel settings-global-panel" action="/admin/settings" method="post">
    <div class="section-title">
      <i data-lucide="sliders-horizontal" class="lucide-icon"></i>
      Điều khiển chung
    </div>
    <div class="two-fields">
      <label>
        Nguồn AI đang dùng
        <%# Chọn provider là quyết định riêng, tách khỏi việc lưu API key ở các
            modal bên dưới. Trước đây mỗi modal giấu một hidden ai_provider nên
            cứ lưu key của provider nào là hệ thống tự chuyển sang chạy provider
            đó, dù admin chỉ định cập nhật key dự phòng. %>
        <select name="ai_provider">
          <% providerOptions.forEach((option) => { %>
            <option value="<%= option.value %>" <%= (settings.ai_provider || 'mock') === option.value ? 'selected' : '' %>>
              <%= option.label %>
            </option>
          <% }) %>
        </select>
      </label>
      <label>
        AI automation
        <select name="ai_automation_enabled">
          <option value="true" <%= settings.ai_automation_enabled !== 'false' ? 'selected' : '' %>>Bật gợi ý thêm</option>
          <option value="false" <%= settings.ai_automation_enabled === 'false' ? 'selected' : '' %>>Tắt, dùng fallback nội bộ</option>
        </select>
      </label>
    </div>
    <div class="two-fields">
      <label>
        Timeout JSON/API (ms)
        <input name="ai_json_timeout_ms" value="<%= settings.ai_json_timeout_ms %>" placeholder="12000">
      </label>
      <label>
        Khối lớp được bật gợi ý
        <input name="ai_enabled_grades" value="<%= settings.ai_enabled_grades || '3,4,5' %>" placeholder="3,4,5">
      </label>
    </div>
    <div class="two-fields">
      <label>
        Cần nộp đáp án trước khi hỏi
        <select name="ai_require_answer_before_help">
          <option value="true" <%= settings.ai_require_answer_before_help !== 'false' ? 'selected' : '' %>>Có</option>
          <option value="false" <%= settings.ai_require_answer_before_help === 'false' ? 'selected' : '' %>>Không</option>
        </select>
      </label>
      <label>
        Số gợi ý tối đa / câu
        <input name="ai_max_hints_per_question" value="<%= settings.ai_max_hints_per_question || '2' %>" placeholder="2">
      </label>
    </div>
    <div class="two-fields">
      <label>
        Số gợi ý tối đa / phiên
        <input name="ai_max_hints_per_session" value="<%= settings.ai_max_hints_per_session || '8' %>" placeholder="8">
      </label>
      <span aria-hidden="true"></span>
    </div>
    <p class="form-note">Các cấu hình này ảnh hưởng tới gợi ý thêm trong lý thuyết, luyện tập và kiểm tra provider.</p>
    <div class="settings-actions">
      <button class="btn btn-primary" type="submit">
        <i data-lucide="save" class="lucide-icon"></i>
        Lưu điều khiển chung
      </button>
    </div>
  </form>

  <section class="settings-provider-grid" aria-label="Danh sách nguồn API">
    <button class="provider-card <%= !settings.ai_provider || settings.ai_provider === 'mock' || settings.ai_provider === 'openai' ? 'active' : '' %>" type="button" data-settings-target="openai">
      <span class="provider-icon"><i data-lucide="bot" class="lucide-icon"></i></span>
      <span><strong>OpenAI</strong><small><%= settings.openai_api_key ? 'Đã cấu hình key' : 'Chưa có API key' %></small></span>
    </button>
    <button class="provider-card <%= settings.ai_provider === 'gemini' ? 'active' : '' %>" type="button" data-settings-target="gemini">
      <span class="provider-icon"><i data-lucide="sparkles" class="lucide-icon"></i></span>
      <span><strong>Gemini API</strong><small><%= settings.gemini_api_key ? 'Đã cấu hình key' : 'Chưa có API key' %></small></span>
    </button>
    <button class="provider-card <%= settings.ai_provider === 'gemini_cli' ? 'active' : '' %>" type="button" data-settings-target="gemini-cli">
      <span class="provider-icon"><i data-lucide="terminal" class="lucide-icon"></i></span>
      <span><strong>Gemini CLI</strong><small>OAuth local</small></span>
    </button>
    <button class="provider-card <%= settings.ai_provider === 'nvidia' ? 'active' : '' %>" type="button" data-settings-target="nvidia">
      <span class="provider-icon"><i data-lucide="cpu" class="lucide-icon"></i></span>
      <span><strong>NVIDIA NIM</strong><small><%= settings.nvidia_nim_api_key ? 'Đã cấu hình key' : 'Chưa có API key' %></small></span>
    </button>
    <button class="provider-card <%= settings.ai_provider === 'openrouter' ? 'active' : '' %>" type="button" data-settings-target="openrouter">
      <span class="provider-icon"><i data-lucide="route" class="lucide-icon"></i></span>
      <span><strong>OpenRouter</strong><small><%= settings.openrouter_api_key ? 'Đã cấu hình key' : 'Chưa có API key' %></small></span>
    </button>
    <button class="provider-card" type="button" data-settings-target="cloudinary">
      <span class="provider-icon"><i data-lucide="image-up" class="lucide-icon"></i></span>
      <span><strong>Cloudinary</strong><small><%= settings.cloudinary_cloud_name && settings.cloudinary_api_key && settings.cloudinary_api_secret ? 'Đã cấu hình' : 'Đang dùng fallback local nếu thiếu' %></small></span>
    </button>
  </section>
</section>

<% function modelField(label, name, currentValue, models) { %>
  <div class="model-field">
    <label><%= label %></label>
    <select data-model-select="<%= name %>">
      <% models.forEach((model) => { %>
        <option value="<%= model %>" <%= currentValue === model ? 'selected' : '' %>><%= model %></option>
      <% }) %>
      <option value="__custom__" <%= models.includes(currentValue) ? '' : 'selected' %>>Model khác</option>
    </select>
    <input name="<%= name %>" data-model-input="<%= name %>" value="<%= currentValue %>" placeholder="Nhập model mới">
  </div>
<% } %>

<dialog class="settings-modal" data-settings-modal="openai">
  <form class="settings-modal-card" action="/admin/settings" method="post">
    <header class="settings-modal-head">
      <div><p class="eyebrow">Nguồn AI</p><h2>OpenAI</h2></div>
      <button class="icon-button" type="button" data-modal-close aria-label="Đóng"><i data-lucide="x" class="lucide-icon"></i></button>
    </header>
    <div class="settings-modal-body">
      <label>OpenAI API key
        <input name="openai_api_key" type="password" autocomplete="off"
          placeholder="<%= settings.openai_api_key ? `Đang dùng key ${maskSecret(settings.openai_api_key)} — nhập để thay` : 'Nhập OpenAI API key' %>">
      </label>
      <label>Base URL <input name="openai_base_url" value="<%= settings.openai_base_url %>" placeholder="https://api.openai.com/v1"></label>
      <% modelField('Chat model', 'openai_model', settings.openai_model, openaiChatModels); %>
    </div>
    <div class="api-check-status" data-check-status hidden></div>
    <footer class="settings-modal-actions">
      <button class="btn btn-secondary" type="button" data-check-provider="openai"><i data-lucide="plug-zap" class="lucide-icon"></i>Check</button>
      <span class="modal-spacer"></span>
      <button class="btn btn-secondary" type="button" data-modal-close>Hủy</button>
      <button class="btn btn-primary" type="submit">Lưu</button>
    </footer>
  </form>
</dialog>

