<section class="auth-shell">
  <div class="auth-layout auth-layout-single">
    <div class="auth-panel">
      <p class="eyebrow">Mã xác thực</p>
      <h1>Đặt lại mật khẩu</h1>
      <p class="form-note auth-intro">Nhập mã 6 số trong email và tạo mật khẩu mới. Mã có hiệu lực trong 10 phút.</p>
      <form class="stack-form" action="/auth/reset-password" method="post" data-password-match-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Mã xác thực 6 số<input class="verification-code-input" name="verification_code" inputmode="numeric" autocomplete="one-time-code" minlength="6" maxlength="6" pattern="[0-9]{6}" data-verification-code required></label>
        <label>Mật khẩu mới<span class="password-field"><input name="password" type="password" autocomplete="new-password" minlength="10" maxlength="72" data-password-policy data-password-primary required><button type="button" class="password-toggle" data-password-toggle aria-label="Hiện mật khẩu" aria-pressed="false"><i data-lucide="eye" class="lucide-icon"></i></button></span></label>
        <label>Xác nhận mật khẩu mới<span class="password-field"><input name="confirm_password" type="password" autocomplete="new-password" minlength="10" maxlength="72" data-password-confirm required><button type="button" class="password-toggle" data-password-toggle aria-label="Hiện mật khẩu" aria-pressed="false"><i data-lucide="eye" class="lucide-icon"></i></button></span></label>
        <button class="btn btn-primary full-width" type="submit"><i data-lucide="key-round" class="lucide-icon"></i>Xác nhận và đổi mật khẩu</button>
      </form>
      <div class="auth-links"><span>Chưa nhận được mã?</span><a href="/auth/forgot-password">Gửi lại</a></div>
    </div>
  </div>
</section>
<%
  if (typeof pageStyles !== 'undefined') pageStyles.push('/css/auth/common.css');
  if (typeof pageScripts !== 'undefined') pageScripts.push('/js/auth/common.js');
%>
