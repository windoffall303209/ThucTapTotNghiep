<section class="auth-shell">
  <div class="auth-layout">
    <aside class="auth-copy">
      <p class="eyebrow">Tài khoản học sinh</p>
      <h2>Bắt đầu bằng đúng lớp đang học.</h2>
      <p>Hệ thống dùng khối lớp để mở chương trình phù hợp và theo dõi tiến trình luyện tập của từng học sinh.</p>
      <ul>
        <li>Chọn <%= gradeRangeLabel %> khi tạo tài khoản</li>
        <li>Học lý thuyết trước khi luyện câu hỏi</li>
        <li>Xem lại lỗi sai để ôn đúng trọng tâm</li>
      </ul>
    </aside>

    <div class="auth-panel">
      <p class="eyebrow">Đăng ký học tập</p>
      <h1>Tạo tài khoản học sinh</h1>
      <form class="stack-form" action="/auth/register" method="post" data-password-match-form>
        <label>
          Họ và tên học sinh
          <input name="fullname" autocomplete="name" required>
        </label>
        <label>
          Tên đăng nhập
          <input name="username" autocomplete="username" required>
        </label>
        <div class="two-fields">
          <label>
            Mật khẩu
            <span class="password-field">
              <input name="password" type="password" autocomplete="new-password" minlength="8" required>
              <button type="button" class="password-toggle" data-password-toggle aria-label="Hiện mật khẩu" aria-pressed="false">
                <i data-lucide="eye" class="lucide-icon"></i>
              </button>
            </span>
          </label>
          <label>
            Nhập lại mật khẩu
            <span class="password-field">
              <input name="confirmPassword" type="password" autocomplete="new-password" minlength="8" required>
              <button type="button" class="password-toggle" data-password-toggle aria-label="Hiện mật khẩu" aria-pressed="false">
                <i data-lucide="eye" class="lucide-icon"></i>
              </button>
            </span>
          </label>
        </div>
        <label>
          Khối học hiện tại
          <%# Bắt buộc tự chọn lớp thay vì mặc định sẵn Lớp 1: chọn nhầm lớp là
              thấy sai toàn bộ chương trình và phải nhờ người lớn sửa lại. %>
          <select name="grade" required>
            <option value="" selected disabled>— Em học lớp mấy? —</option>
            <% gradeOptions.forEach((grade) => { %>
              <option value="<%= grade.value %>"><%= grade.label %></option>
            <% }) %>
          </select>
        </label>
        <p class="form-note">Mật khẩu tối thiểu 8 ký tự. Nếu lỡ chọn nhầm lớp, em nhờ thầy cô sửa lại giúp nhé.</p>
        <button class="btn btn-primary full-width" type="submit">
          <i data-lucide="user-plus" class="lucide-icon"></i>
          Tạo tài khoản và vào bảng học tập
        </button>
      </form>
      <div class="auth-links">
        <a href="/auth/login">Đã có tài khoản?</a>
      </div>
    </div>
  </div>
</section>
