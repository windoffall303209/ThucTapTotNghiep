<section class="auth-shell">
  <div class="auth-layout auth-layout-single">
    <div class="auth-panel">
      <p class="eyebrow">Khôi phục tài khoản</p>
      <h1>Quên mật khẩu</h1>
      <p class="form-note auth-intro">Nhập email đã xác minh trong phần tài khoản. Nếu thông tin hợp lệ, mã 6 số sẽ được gửi đến email này.</p>
      <form class="stack-form" action="/auth/forgot-password" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Email đã xác minh<input name="email" type="email" autocomplete="email" maxlength="254" required></label>
        <button class="btn btn-primary full-width" type="submit"><i data-lucide="mail" class="lucide-icon"></i>Gửi mã đặt lại mật khẩu</button>
      </form>
      <div class="auth-links"><span>Đã nhớ mật khẩu?</span><a href="/auth/student/login">Đăng nhập</a></div>
    </div>
  </div>
</section>
<%
  if (typeof pageStyles !== 'undefined') pageStyles.push('/css/auth/common.css');
  if (typeof pageScripts !== 'undefined') pageScripts.push('/js/auth/common.js');
%>
