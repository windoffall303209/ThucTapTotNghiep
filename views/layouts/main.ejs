<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title ? `${title} | Toán Bổ Trợ Tiểu học` : 'Toán Bổ Trợ Tiểu học' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <meta name="theme-color" content="#2563eb">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css">
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/content-renderer.css">
    <% if (student) { %>
      <link rel="stylesheet" href="/css/student/common.css">
    <% } %>
    <% if (admin) { %>
      <link rel="stylesheet" href="/css/admin/common.css">
    <% } %>
    <% for (const stylesheet of (typeof pageStyles !== 'undefined' ? pageStyles : [])) { %>
      <link rel="stylesheet" href="<%= stylesheet %>">
    <% } %>
  </head>
  <body
    class="<%= admin ? 'admin-body' : '' %><%= student ? ' student-body' : '' %>"
    <% if (student) { %>data-grade="<%= student.current_grade %>"<% } %>>
    <%- include('../partials/header') %>
    <main class="page-shell">
      <% if (flash) { %>
        <div class="flash flash-<%= flash.type %>" role="status">
          <%= flash.message %>
        </div>
      <% } %>
      <%- body %>
    </main>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>
    <%# Ghim đúng phiên bản lucide thay vì @latest: bản mới phát hành có thể đổi
        tên icon hoặc API createIcons và làm vỡ toàn bộ icon của site mà không ai
        đụng vào mã nguồn. Dùng jsdelivr cho đồng bộ với KaTeX ở trên. %>
    <script defer src="https://cdn.jsdelivr.net/npm/lucide@0.469.0/dist/umd/lucide.min.js"></script>
    <script defer src="/js/common.js"></script>
    <% if (admin) { %>
      <script defer src="/js/admin/common.js"></script>
    <% } %>
    <% for (const script of (typeof pageScripts !== 'undefined' ? pageScripts : [])) { %>
      <script defer src="<%= script %>"></script>
    <% } %>
  </body>
</html>
