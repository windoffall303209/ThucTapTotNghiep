<%# Mẫu giao diện main kết hợp dữ liệu máy chủ với HTML để hiển thị một màn hình của ứng dụng. %>
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title><%= title ? `${title} | Toán Bổ Trợ Tiểu học` : 'Toán Bổ Trợ Tiểu học' %></title>
    <meta name="theme-color" content="#2563eb">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="stylesheet" href="/vendor/nunito/500.css">
    <link rel="stylesheet" href="/vendor/nunito/600.css">
    <link rel="stylesheet" href="/vendor/nunito/700.css">
    <link rel="stylesheet" href="/vendor/nunito/800.css">
    <link rel="stylesheet" href="/vendor/nunito/900.css">
    <%# Khối xử lý trong mẫu quyết định nội dung giao diện dựa trên dữ liệu máy chủ. %>
    <% if (student || admin) { %>
      <link rel="stylesheet" href="/vendor/katex/katex.min.css">
    <% } %>
    <link rel="stylesheet" href="/css/common.css">
    <%# Khối xử lý trong mẫu quyết định nội dung giao diện dựa trên dữ liệu máy chủ. %>
    <% if (student || admin) { %>
      <link rel="stylesheet" href="/css/content-renderer.css">
    <% } %>
    <%# Khối xử lý trong mẫu quyết định nội dung giao diện dựa trên dữ liệu máy chủ. %>
    <% if (student) { %>
      <link rel="stylesheet" href="/css/student/common.css">
    <% } %>
    <%# Khối xử lý trong mẫu quyết định nội dung giao diện dựa trên dữ liệu máy chủ. %>
    <% if (admin) { %>
      <link rel="stylesheet" href="/css/admin/common.css">
    <% } %>
    <%# Khối xử lý trong mẫu quyết định nội dung giao diện dựa trên dữ liệu máy chủ. %>
    <% for (const stylesheet of (typeof pageStyles !== 'undefined' ? pageStyles : [])) { %>
      <link rel="stylesheet" href="<%= stylesheet %>">
    <% } %>
  </head>
  <body
    class="<%= admin ? 'admin-body' : '' %><%= student ? ' student-body' : '' %>"
<%# Khối xử lý trong mẫu quyết định nội dung giao diện dựa trên dữ liệu máy chủ. %>
    <% if (student) { %>data-grade="<%= student.current_grade %>"<% } %>>
    <a class="skip-link" href="#main-content">Chuyển đến nội dung chính</a>
    <%- include('../partials/header') %>
    <main id="main-content" class="page-shell" tabindex="-1">
      <%# Khối xử lý trong mẫu quyết định nội dung giao diện dựa trên dữ liệu máy chủ. %>
      <% if (flash && flash.modal) { %>
        <div
          data-flash-modal
          data-tone="<%= flash.type %>"
          data-title="<%= flash.type === 'warning' ? 'Thông báo' : 'Có điều cần lưu ý' %>"
          data-message="<%= flash.message %>"
          hidden></div>
      <% } else if (flash) { %>
        <div
          class="flash flash-<%= flash.type %><%= flash.transient ? ' flash-toast' : '' %>"
          role="status"
          aria-live="polite"
          <%# Khối xử lý trong mẫu quyết định nội dung giao diện dựa trên dữ liệu máy chủ. %>
          <% if (flash.transient) { %>
            data-flash-autohide="true"
            data-duration="<%= Number(flash.durationMs || 3000) %>"
          <% } %>>
          <%= flash.message %>
        </div>
      <% } %>
      <%- body %>
    </main>
    <dialog id="appDialog" class="app-dialog" aria-labelledby="appDialogTitle" aria-describedby="appDialogMessage">
      <div class="app-dialog-card">
        <div class="app-dialog-icon" data-app-dialog-icon aria-hidden="true">
          <i data-lucide="info" class="lucide-icon"></i>
        </div>
        <div class="app-dialog-copy">
          <h2 id="appDialogTitle">Thông báo</h2>
          <p id="appDialogMessage"></p>
        </div>
        <div class="app-dialog-actions">
          <button class="btn btn-secondary" type="button" data-app-dialog-cancel>Hủy</button>
          <button class="btn btn-primary" type="button" data-app-dialog-confirm>Đồng ý</button>
        </div>
      </div>
    </dialog>
    <%# Khối xử lý trong mẫu quyết định nội dung giao diện dựa trên dữ liệu máy chủ. %>
    <% if (student || admin) { %>
      <script defer src="/vendor/katex/katex.min.js"></script>
      <script defer src="/vendor/katex/contrib/auto-render.min.js"></script>
      <script defer src="/js/content-renderer.js"></script>
    <% } %>
    <script defer src="/vendor/lucide/lucide.min.js"></script>
    <script defer src="/js/common.js"></script>
    <%# Khối xử lý trong mẫu quyết định nội dung giao diện dựa trên dữ liệu máy chủ. %>
    <% if (admin) { %>
      <script defer src="/js/admin/common.js"></script>
    <% } %>
    <%# Khối xử lý trong mẫu quyết định nội dung giao diện dựa trên dữ liệu máy chủ. %>
    <% for (const script of (typeof pageScripts !== 'undefined' ? pageScripts : [])) { %>
      <script defer src="<%= script %>"></script>
    <% } %>
  </body>
</html>
