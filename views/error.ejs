<%# Mẫu giao diện error kết hợp dữ liệu máy chủ với HTML để hiển thị một màn hình của ứng dụng. %>
<section class="auth-shell error-page">
  <div class="narrow-panel">
    <div class="empty-state">
      <%# Hình mặt cười bối rối thay cho icon cảnh báo khô khan: trang lỗi là
          nơi trẻ dễ hoảng, giọng điệu cần nhẹ nhàng như một sự cố nhỏ. %>
      <span class="error-face" aria-hidden="true">😵‍💫</span>
      <div>
        <p class="eyebrow">Ôi, có chuyện nhỏ xảy ra</p>
        <h1><%= title %></h1>
        <p><%= message %></p>
      </div>
      <a class="btn btn-primary" href="/">
        <i data-lucide="arrow-left" class="lucide-icon"></i>
        Về trang chính
      </a>
    </div>
  </div>
</section>
<%# Khối xử lý trong mẫu quyết định nội dung giao diện dựa trên dữ liệu máy chủ. %>
<% if (typeof pageStyles !== 'undefined') pageStyles.push('/css/error.css'); %>
