<section class="workspace-head">
  <div>
    <p class="eyebrow">Hôm nay học gì?</p>
    <h1>Chào, <%= student.fullname %></h1>
    <p>Lớp <%= student.current_grade %> · Chọn bài cần học tiếp, ôn lại phần còn yếu hoặc luyện đề tổng hợp.</p>
  </div>
  <div class="row-actions">
    <a class="btn btn-secondary" href="/student/history">
      <i data-lucide="history" class="lucide-icon"></i>
      Xem lịch sử
    </a>
    <a class="btn btn-primary" href="/student/exams">
      <i data-lucide="clipboard-list" class="lucide-icon"></i>
      Luyện đề
    </a>
  </div>
</section>

<section class="today-grid">
  <article class="stat-card">
    <span class="status-pill status-in-progress">Bài đã luyện</span>
    <strong class="stat-value"><%= progress.percent %>%</strong>
    <p class="muted">Đã có lượt luyện ở <strong><%= progress.completed %></strong>/<strong><%= progress.total %></strong> bài có dữ liệu.</p>
    <div class="progress-track large"><span style="width: <%= progress.percent %>%"></span></div>
  </article>
  <article class="action-card">
    <span class="status-pill status-review">Cần ôn</span>
    <% if (recommendation) { %>
      <strong><%= recommendation.lesson_name %></strong>
      <p class="muted">Hệ thống thấy bài này có lỗi sai nổi bật. Ôn lại lý thuyết trước khi luyện tiếp.</p>
      <a class="btn btn-secondary" href="/student/lessons/<%= recommendation.id %>">Ôn lại bài này</a>
    <% } else { %>
      <strong>Chưa có bài yếu rõ ràng</strong>
      <p class="muted">Em có thể chọn bài mới bên dưới hoặc làm một đề ngẫu nhiên.</p>
      <a class="btn btn-secondary" href="/student/exams">Chọn phạm vi luyện tập</a>
    <% } %>
  </article>
  <article class="action-card">
    <span class="status-pill status-new">Bước tiếp theo</span>
    <strong>Học theo chương bài</strong>
    <p class="muted">Mở một chương, đọc lý thuyết ngắn rồi làm câu hỏi để hệ thống ghi nhận tiến trình.</p>
    <a class="btn btn-primary" href="#chuong-hoc">Xem chương học</a>
  </article>
</section>

<section id="chuong-hoc" class="curriculum-list">
  <div class="section-title">
    <i data-lucide="book-open" class="lucide-icon"></i>
    Chương học lớp <%= student.current_grade %>
  </div>

  <% if (chapters.length === 0) { %>
    <div class="empty-state compact">
      <p>Chưa có chương học cho khối này. Quản trị viên cần nhập dữ liệu chương và bài học.</p>
    </div>
  <% } %>

  <% chapters.forEach((chapter, index) => { %>
    <details class="chapter-panel" <%= index === 0 ? 'open' : '' %>>
      <summary>
        <span><%= chapter.chapter_name %></span>
        <small><%= chapter.lessons.length %> bài học</small>
      </summary>
      <div class="lesson-list">
        <% chapter.lessons.forEach((lesson) => { %>
          <% const lessonStat = lessonProgress[lesson.id] || { status: 'not_started', attempt_count: 0, correct_count: 0, wrong_count: 0 }; %>
          <article class="lesson-row">
            <div>
              <h2><%= lesson.lesson_name %></h2>
              <% if (lessonStat.status === 'completed') { %>
                <p><span class="status-pill status-completed">Đã luyện</span> Đúng <%= lessonStat.correct_count %>/<%= lessonStat.attempt_count %> lượt làm.</p>
              <% } else if (lessonStat.status === 'needs_review') { %>
                <p><span class="status-pill status-review">Cần ôn</span> Sai <%= lessonStat.wrong_count %> lượt, nên đọc lại lý thuyết.</p>
              <% } else { %>
                <p><span class="status-pill status-new">Chưa luyện</span> Bắt đầu bằng lý thuyết rồi chuyển sang câu hỏi.</p>
              <% } %>
            </div>
            <div class="row-actions">
              <a class="btn btn-secondary" href="/student/lessons/<%= lesson.id %>">
                <i data-lucide="book-text" class="lucide-icon"></i>
                Lý thuyết
              </a>
              <a class="btn btn-primary" href="/student/lessons/<%= lesson.id %>/practice">
                <i data-lucide="play-circle" class="lucide-icon"></i>
                Luyện tập
              </a>
            </div>
          </article>
        <% }) %>
      </div>
    </details>
  <% }) %>
</section>

<section class="table-section">
  <div class="section-title">
    <i data-lucide="activity" class="lucide-icon"></i>
    Hoạt động gần đây
  </div>

  <% if (!recentAttempts || recentAttempts.length === 0) { %>
    <div class="empty-state compact">
      <p>Em chưa có lịch sử làm bài. Hãy chọn một bài học và nộp đáp án để hệ thống ghi nhận tiến trình.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Bài học</th>
            <th>Kết quả</th>
            <th>Em chọn</th>
            <th>Đáp án đúng</th>
            <th>Thời gian</th>
          </tr>
        </thead>
        <tbody>
          <% recentAttempts.forEach((attempt) => { %>
            <tr>
              <td><%= attempt.lesson_name %></td>
              <td>
                <% if (Number(attempt.is_correct) === 1 || attempt.is_correct === true) { %>
                  <span class="status-pill status-completed">Đúng</span>
                <% } else { %>
                  <span class="status-pill status-review">Cần xem lại</span>
                <% } %>
              </td>
              <td><%= attempt.selected_answer %></td>
              <td><%= attempt.correct_answer %></td>
              <td><%= attempt.created_at ? new Date(attempt.created_at).toLocaleString('vi-VN') : 'Vừa xong' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
