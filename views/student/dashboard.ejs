<section class="workspace-head">
  <div>
    <p class="eyebrow">Hôm nay học gì?</p>
    <h1>Chào, <%= student.fullname %></h1>
    <p>Lớp <%= student.current_grade %> · Chọn bài cần học tiếp, ôn lại phần còn yếu hoặc luyện tập tổng hợp.</p>
  </div>
  <div class="row-actions">
    <a class="btn btn-secondary" href="/student/history">
      <i data-lucide="history" class="lucide-icon"></i>
      Xem lịch sử
    </a>
    <a class="btn btn-primary" href="/student/exams">
      <i data-lucide="clipboard-list" class="lucide-icon"></i>
      Chọn bài để luyện
    </a>
  </div>
</section>

<section class="today-grid">
  <article class="stat-card">
    <span class="status-pill status-in-progress">Bài đã luyện</span>
    <strong class="stat-value"><%= progress.percent %>%</strong>
    <p class="muted">Em đã luyện <strong><%= progress.completed %></strong> trên <strong><%= progress.total %></strong> bài của lớp mình.</p>
    <div
      class="progress-track large"
      role="progressbar"
      aria-valuenow="<%= progress.percent %>"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-label="Em đã luyện <%= progress.completed %> trên <%= progress.total %> bài">
      <span style="width: <%= progress.percent %>%"></span>
    </div>
  </article>
  <article class="action-card">
    <span class="status-pill status-review">Cần ôn</span>
    <% if (recommendation) { %>
      <strong><%= recommendation.lesson_name %></strong>
      <p class="muted">Hệ thống thấy bài này có lỗi sai nổi bật. Ôn lại lý thuyết trước khi luyện tiếp.</p>
      <a class="btn btn-secondary" href="/student/lessons/<%= recommendation.id %>">Ôn lại bài này</a>
    <% } else { %>
      <strong>Em đang học tốt, chưa có bài nào cần ôn lại</strong>
      <p class="muted">Em có thể chọn bài mới bên dưới hoặc làm một bài luyện tổng hợp.</p>
      <a class="btn btn-secondary" href="/student/exams">Chọn bài để luyện</a>
    <% } %>
  </article>
  <article class="action-card next-lesson-card">
    <span class="status-pill status-new">Bước tiếp theo</span>
    <% if (nextLesson) { %>
      <strong><%= nextLesson.lesson_name %></strong>
      <p class="muted">
        <% if (nextLesson.reason === 'needs_review') { %>
          Bài này em còn làm sai nhiều, luyện lại để nắm chắc hơn.
        <% } else if (nextLesson.reason === 'not_started') { %>
          Bài tiếp theo em chưa luyện, thuộc <%= nextLesson.chapter_name %>.
        <% } else { %>
          Em đã luyện hết các bài. Làm lại bài này để ôn cho nhớ lâu.
        <% } %>
      </p>
      <div class="row-actions">
        <a class="btn btn-primary" href="/student/lessons/<%= nextLesson.id %>/practice">
          <i data-lucide="play-circle" class="lucide-icon"></i>
          Luyện ngay
        </a>
        <a class="btn btn-secondary" href="/student/lessons/<%= nextLesson.id %>">
          <i data-lucide="book-text" class="lucide-icon"></i>
          Đọc lý thuyết
        </a>
      </div>
    <% } else { %>
      <strong>Học theo chương bài</strong>
      <p class="muted">Mở một chương, đọc phần lý thuyết ngắn rồi làm thử vài câu hỏi nhé.</p>
      <a class="btn btn-primary" href="#chuong-hoc">Xem chương học</a>
    <% } %>
  </article>
</section>

<section id="chuong-hoc" class="curriculum-list">
  <div class="section-title">
    <i data-lucide="book-open" class="lucide-icon"></i>
    Chương học lớp <%= student.current_grade %>
  </div>

  <% if (chapters.length === 0) { %>
    <div class="empty-state compact">
      <%# Empty state là màn hình học sinh nhìn thấy, không phải nơi giao việc
          cho quản trị viên. Nói với các em bằng giọng của các em và chỉ một
          lối đi tiếp. %>
      <p>Các bài học của lớp em đang được chuẩn bị. Em quay lại sau nhé!</p>
      <a class="btn btn-secondary" href="/student/account">
        <i data-lucide="user-circle" class="lucide-icon"></i>
        Xem trang tài khoản
      </a>
    </div>
  <% } %>

  <% chapters.forEach((chapter, index) => { %>
    <details class="chapter-panel" <%= index === 0 ? 'open' : '' %>>
      <summary>
        <span><%= chapter.chapter_name %></span>
        <small><%= chapter.lessons.length %> bài học</small>
      </summary>
      <div class="lesson-list">
        <% chapter.lessons.forEach((lesson) => { %>
          <% const lessonStat = lessonProgress[lesson.id] || { status: 'not_started', attempt_count: 0, correct_count: 0, wrong_count: 0 }; %>
          <article class="lesson-row">
            <div>
              <h2><%= lesson.lesson_name %></h2>
              <% if (lessonStat.status === 'completed') { %>
                <p><span class="status-pill status-completed">Đã luyện</span> Đúng <%= lessonStat.correct_count %>/<%= lessonStat.attempt_count %> lượt làm.</p>
              <% } else if (lessonStat.status === 'needs_review') { %>
                <p><span class="status-pill status-review">Cần ôn</span> Sai <%= lessonStat.wrong_count %> lượt, nên đọc lại lý thuyết.</p>
              <% } else { %>
                <p><span class="status-pill status-new">Chưa luyện</span> Bắt đầu bằng lý thuyết rồi chuyển sang câu hỏi.</p>
              <% } %>
            </div>
            <div class="row-actions">
              <a class="btn btn-secondary" href="/student/lessons/<%= lesson.id %>">
                <i data-lucide="book-text" class="lucide-icon"></i>
                Lý thuyết
              </a>
              <a class="btn btn-primary" href="/student/lessons/<%= lesson.id %>/practice">
                <i data-lucide="play-circle" class="lucide-icon"></i>
                Luyện tập
              </a>
            </div>
          </article>
        <% }) %>
      </div>
    </details>
  <% }) %>
</section>

<section class="table-section">
  <div class="section-title">
    <i data-lucide="activity" class="lucide-icon"></i>
    Hoạt động gần đây
  </div>

  <% if (!recentAttempts || recentAttempts.length === 0) { %>
    <div class="empty-state compact">
      <p>Em chưa làm bài nào. Chọn một bài học ở trên và làm thử — kết quả sẽ hiện ở đây.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="stacked-table">
        <thead>
          <tr>
            <th>Bài học</th>
            <th>Kết quả</th>
            <th>Em chọn</th>
            <th>Đáp án đúng</th>
            <th>Thời gian</th>
          </tr>
        </thead>
        <tbody>
          <% recentAttempts.forEach((attempt) => { %>
            <tr>
              <td data-label="Bài học"><%= attempt.lesson_name %></td>
              <td data-label="Kết quả">
                <% if (Number(attempt.is_correct) === 1 || attempt.is_correct === true) { %>
                  <span class="status-pill status-completed">Đúng</span>
                <% } else { %>
                  <span class="status-pill status-review">Cần xem lại</span>
                <% } %>
              </td>
              <td data-label="Em chọn"><%= attempt.selected_answer %></td>
              <td data-label="Đáp án đúng"><%= attempt.correct_answer %></td>
              <td data-label="Thời gian"><%= attempt.created_at ? new Date(attempt.created_at).toLocaleString('vi-VN') : 'Vừa xong' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<% if (typeof pageStyles !== 'undefined') pageStyles.push('/css/student/dashboard.css'); %>
