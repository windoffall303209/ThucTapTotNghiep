<%# M?u giao di?n practice k?t h?p d? li?u m?y ch? v?i HTML ?? hi?n th? m?t m?n h?nh c?a ?ng d?ng. %>
<% const timing = typeof practiceTiming !== 'undefined' ? practiceTiming : { enabled: false }; %>
<section class="practice-shell <%= aiHelpEnabled ? '' : 'practice-shell-no-chat' %>" data-session-id="<%= session?.id || '' %>">
  <div class="practice-main">
    <div class="practice-topline">
      <%# Kh?i ?i?u ki?n trong m?u quy?t ??nh n?i dung giao di?n d?a tr?n d? li?u m?y ch?. %>
      <% if (['CHAPTER', 'COMPREHENSIVE'].includes(session?.session_mode)) { %>
        <a class="back-link" href="/student/exams">
          <i data-lucide="arrow-left" class="lucide-icon"></i>
          Về chọn phạm vi
        </a>
      <% } else { %>
        <a class="back-link" href="/student/lessons/<%= lesson.id %>">
          <i data-lucide="arrow-left" class="lucide-icon"></i>
          Về lý thuyết
        </a>
      <% } %>
      <%# Không in sẵn "Câu 1/..." vì khi mở lại bài đang làm dở, câu hiện tại
          không phải câu 1 — con số cứng nháy sai một nhịp rồi mới bị JS sửa.
          Để JS điền ngay khi dựng câu hỏi đầu tiên. %>
      <div class="practice-status">
        <%# Kh?i ?i?u ki?n trong m?u quy?t ??nh n?i dung giao di?n d?a tr?n d? li?u m?y ch?. %>
        <% if (timing.enabled) { %>
          <span
            id="practiceTimer"
            class="practice-timer"
            role="timer"
            aria-label="Thời gian còn lại">
            <i data-lucide="clock-3" class="lucide-icon"></i>
            <span data-timer-value>--:--</span>
          </span>
        <% } %>
        <span id="questionCounter">Câu …/<%= Math.max(questions.length, 1) %></span>
      </div>
    </div>

    <%# Kh?i ?i?u ki?n trong m?u quy?t ??nh n?i dung giao di?n d?a tr?n d? li?u m?y ch?. %>
    <% if (questions.length > 0) { %>
      <nav id="questionProgressBar" class="question-progress" aria-label="Danh sách câu hỏi trong bài">
        <%# Kh?i l?p trong m?u t?o n?i dung ??ng t? danh s?ch d? li?u m?y ch?. %>
        <% questions.forEach((question, index) => { %>
          <button
            class="progress-dot"
            type="button"
            data-progress-dot
            data-index="<%= index %>"
            aria-label="Câu <%= index + 1 %>">
            <%= index + 1 %>
          </button>
        <% }) %>
      </nav>
    <% } %>

    <h1><%= session?.title || lesson.lesson_name %></h1>
    <%# Kh?i ?i?u ki?n trong m?u quy?t ??nh n?i dung giao di?n d?a tr?n d? li?u m?y ch?. %>
    <% if (questions.length === 0) { %>
      <div class="empty-state compact">
        <p>Bài này chưa có câu hỏi luyện tập. Em chọn bài khác nhé!</p>
        <a class="btn btn-primary" href="/student/dashboard#chuong-hoc">
          <i data-lucide="book-open" class="lucide-icon"></i>
          Chọn bài khác
        </a>
      </div>
    <% } else { %>
      <div class="practice-panel">
        <div class="section-title">
          <i data-lucide="focus" class="lucide-icon"></i>
          Làm từng câu, xem phản hồi sau khi nộp
        </div>
        <div id="practiceApp" class="question-zone"></div>
        <%# aria-live: kết quả chấm phải được trình đọc màn hình tự đọc lên ngay
            khi hiện ra, không bắt học sinh dò lại trang. %>
        <div id="answerFeedback" class="answer-feedback" aria-live="polite" hidden></div>
        <div id="practiceSummary" class="practice-summary" role="status" hidden></div>
        <div class="practice-actions">
          <button id="submitAnswerButton" class="btn btn-primary" type="button">
            <i data-lucide="check-circle" class="lucide-icon"></i>
            Nộp đáp án
          </button>
          <button id="nextQuestionButton" class="btn btn-secondary" type="button" hidden>
            <i data-lucide="arrow-right" class="lucide-icon"></i>
            Câu tiếp theo
          </button>
          <button id="finishPracticeButton" class="btn btn-secondary" type="button" hidden>
            <i data-lucide="flag" class="lucide-icon"></i>
            Kết thúc bài làm
          </button>
        </div>
      </div>
    <% } %>
  </div>

  <%# Kh?i ?i?u ki?n trong m?u quy?t ??nh n?i dung giao di?n d?a tr?n d? li?u m?y ch?. %>
  <% if (aiHelpEnabled) { %>
    <aside class="ai-chat">
      <div class="chat-head">
        <div>
          <strong>Gợi ý thêm</strong>
          <small>Chỉ hỗ trợ sau khi em thử làm bài</small>
        </div>
        <i data-lucide="sparkles" class="lucide-icon"></i>
      </div>
      <%# aria-live để trình đọc màn hình đọc câu trả lời mới của trợ lý ngay
          khi nó hiện ra, thay vì im lặng. %>
      <div id="chatMessages" class="chat-messages" aria-live="polite">
        <div class="chat-message ai">Khi em gặp khó, hãy thử chọn đáp án trước. Sau đó bấm một nút bên dưới hoặc tự gõ câu hỏi nhé.</div>
      </div>
      <%# Nút gợi ý bấm-là-hỏi: học sinh lớp 1-2 chưa gõ được câu hỏi tự do,
          không có các nút này thì khung chat gần như vô dụng với các em. %>
      <div class="chat-quick-actions" aria-label="Câu hỏi nhanh">
        <button type="button" class="chat-quick" data-chat-quick="Em chưa hiểu câu này, giải thích dễ hơn giúp em.">
          Giải thích dễ hơn
        </button>
        <button type="button" class="chat-quick" data-chat-quick="Cho em một ví dụ khác giống câu này.">
          Cho em ví dụ khác
        </button>
        <button type="button" class="chat-quick" data-chat-quick="Em phải bắt đầu từ bước nào trước?">
          Bắt đầu từ đâu?
        </button>
      </div>
      <form id="aiHelpForm" class="chat-form">
        <label class="sr-only" for="aiHelpInput">Câu hỏi của em</label>
        <input id="aiHelpInput" name="message" placeholder="Ví dụ: Em chưa hiểu bước rút gọn...">
        <button type="submit" aria-label="Gửi câu hỏi">
          <i data-lucide="send" class="lucide-icon"></i>
        </button>
      </form>
    </aside>
  <% } %>
</section>

<script id="practice-data" type="application/json"><%- safeJsonForHtml(questions) %></script>
<script id="practice-context" type="application/json"><%- safeJsonForHtml({
  practiceSessionId: session?.id || null,
  currentIndex: session?.current_index || 0,
  answeredResults: answeredResults || {},
  timing: timing.enabled ? {
    durationSeconds: timing.durationSeconds,
    deadlineAtMs: timing.deadlineAtMs,
    serverNowMs: timing.serverNowMs
  } : null
}) %></script>
<%
  if (typeof pageStyles !== 'undefined') {
    pageStyles.push('/css/student/question-image-viewer.css');
    pageStyles.push('/css/student/practice.css');
  }
  if (typeof pageScripts !== 'undefined') {
    pageScripts.push('/js/student/question-image-viewer.js');
    pageScripts.push('/js/student/practice.js');
  }
%>
