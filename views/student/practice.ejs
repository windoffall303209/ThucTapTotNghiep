<section class="practice-shell <%= Number(student.current_grade) >= 3 ? '' : 'practice-shell-no-chat' %>" data-session-id="<%= session?.id || '' %>">
  <div class="practice-main">
    <div class="practice-topline">
      <% if (['CHAPTER', 'COMPREHENSIVE'].includes(session?.session_mode)) { %>
        <a class="back-link" href="/student/exams">
          <i data-lucide="arrow-left" class="lucide-icon"></i>
          Về chọn phạm vi
        </a>
      <% } else { %>
        <a class="back-link" href="/student/lessons/<%= lesson.id %>">
          <i data-lucide="arrow-left" class="lucide-icon"></i>
          Về lý thuyết
        </a>
      <% } %>
      <span id="questionCounter">Câu 1/<%= Math.max(questions.length, 1) %></span>
    </div>

    <h1><%= session?.title || lesson.lesson_name %></h1>
    <% if (questions.length === 0) { %>
      <div class="empty-state compact">
        <p>Bài học này chưa có câu hỏi luyện tập. Quản trị viên cần bổ sung ngân hàng câu hỏi.</p>
      </div>
    <% } else { %>
      <div class="practice-panel">
        <div class="section-title">
          <i data-lucide="focus" class="lucide-icon"></i>
          Làm từng câu, xem phản hồi sau khi nộp
        </div>
        <div id="practiceApp" class="question-zone"></div>
        <div id="answerFeedback" class="answer-feedback" hidden></div>
        <div class="practice-actions">
          <button id="submitAnswerButton" class="btn btn-primary" type="button">
            <i data-lucide="check-circle" class="lucide-icon"></i>
            Nộp đáp án
          </button>
          <button id="nextQuestionButton" class="btn btn-secondary" type="button" hidden>
            <i data-lucide="arrow-right" class="lucide-icon"></i>
            Câu tiếp theo
          </button>
          <button id="finishPracticeButton" class="btn btn-secondary" type="button" hidden>
            <i data-lucide="flag" class="lucide-icon"></i>
            Kết thúc bài làm
          </button>
        </div>
      </div>
    <% } %>
  </div>

  <% if (Number(student.current_grade) >= 3) { %>
    <aside class="ai-chat">
      <div class="chat-head">
        <div>
          <strong>Gợi ý thêm</strong>
          <small>Chỉ hỗ trợ sau khi em thử làm bài</small>
        </div>
        <i data-lucide="sparkles" class="lucide-icon"></i>
      </div>
      <div id="chatMessages" class="chat-messages">
        <div class="chat-message ai">Khi em gặp khó, hãy thử chọn đáp án trước. Sau đó hệ thống sẽ giúp em hiểu vì sao đúng hoặc sai.</div>
      </div>
      <form id="aiHelpForm" class="chat-form">
        <input name="message" placeholder="Ví dụ: Em chưa hiểu bước rút gọn...">
        <button type="submit" aria-label="Gửi câu hỏi">
          <i data-lucide="send" class="lucide-icon"></i>
        </button>
      </form>
    </aside>
  <% } %>
</section>

<script id="practice-data" type="application/json"><%- JSON.stringify(questions) %></script>
<script id="practice-context" type="application/json"><%- JSON.stringify({
  practiceSessionId: session?.id || null,
  currentIndex: session?.current_index || 0
}) %></script>
