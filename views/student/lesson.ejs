<%
  function bodyValue(card) {
    const legacyFormulas = Array.isArray(card.formulas)
      ? card.formulas
      : card.formula
        ? [card.formula]
        : [];
    return [card.body || '', ...legacyFormulas].filter(Boolean).join('\n');
  }

  function typeLabel(type) {
    const labels = {
      observe: 'Quan sát',
      concept: 'Kiến thức',
      model: 'Ví dụ mẫu',
      quick_try: 'Thử nhanh',
      remember: 'Ghi nhớ'
    };
    return labels[type] || 'Kiến thức';
  }

  function escapeHtml(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function escapeAttribute(value) {
    return escapeHtml(value).replace(/`/g, '&#096;');
  }

  function gridRenderHtml(grid) {
    if (!grid || !grid.enabled) return '';
    return `<div class="content-grid-render math-content" data-grid-render="${escapeAttribute(JSON.stringify(grid))}"></div>`;
  }
%>

<section class="workspace-head lesson-reading">
  <div>
    <a class="back-link" href="/student/dashboard">
      <i data-lucide="arrow-left" class="lucide-icon"></i>
      Về bảng học tập
    </a>
    <p class="eyebrow">Lớp <%= lesson.grade %> · <%= lesson.chapter_name %></p>
    <h1><%= lesson.lesson_name %></h1>
    <p>Em đọc từng thẻ theo thứ tự, xem hình nếu có, rồi làm thử vài câu để nhớ bài lâu hơn nhé.</p>
  </div>
  <div class="row-actions">
    <% if (Number(reviewQuestionCount || 0) > 0) { %>
      <a class="btn btn-secondary" href="/student/lessons/<%= lesson.id %>/review">
        <i data-lucide="clipboard-check" class="lucide-icon"></i>
        Ôn nhanh <%= reviewQuestionCount %> câu
      </a>
    <% } %>
    <a class="btn btn-primary" href="/student/lessons/<%= lesson.id %>/practice">
      <i data-lucide="shuffle" class="lucide-icon"></i>
      Luyện 5 câu ngẫu nhiên
    </a>
  </div>
</section>

<section class="learning-summary" hidden aria-hidden="true">
  <%# Không đặt tên "Mục tiêu bài học" cho một câu chữ chung: nội dung này giống
      hệt nhau ở mọi bài nên gọi là mục tiêu của bài sẽ thành lời hứa giả. Muốn
      có mục tiêu riêng từng bài thì cần thêm trường dữ liệu trong Lessons. %>
  <div>
    <div class="section-title">
      <i data-lucide="target" class="lucide-icon"></i>
      Em sẽ luyện được gì?
    </div>
    <p>Hiểu ý chính của bài, biết cách làm theo ví dụ mẫu và quen với dạng câu hỏi thường gặp.</p>
  </div>
  <div>
    <div class="section-title">
      <i data-lucide="lightbulb" class="lucide-icon"></i>
      Học thế nào cho dễ nhớ?
    </div>
    <p>Thẻ có hình thì em xem hình trước. Thẻ có bước làm thì em đọc từng dòng rồi tự nhẩm lại cách làm.</p>
  </div>
</section>

<section class="theory-grid">
  <% if (!lesson.theory_cards || lesson.theory_cards.length === 0) { %>
    <div class="empty-state compact">
      <p>Bài này chưa có phần lý thuyết. Em vẫn có thể làm thử câu hỏi luyện tập trước nhé!</p>
      <a class="btn btn-primary" href="/student/lessons/<%= lesson.id %>/practice">
        <i data-lucide="play-circle" class="lucide-icon"></i>
        Luyện tập bài này
      </a>
    </div>
  <% } %>

  <% (lesson.theory_cards || []).forEach((card, index) => { %>
    <% const images = Array.isArray(card.images) ? card.images : []; %>
    <% const hasCardText = Boolean(
      card.title || card.display_text || bodyValue(card) || card.student_task ||
      card.example || card.remember || card.grid_layout?.enabled
    ); %>
    <% const imageOnly = images.length > 0 && !hasCardText; %>
    <article class="theory-card <%= imageOnly ? 'theory-card-image-only' : '' %> theory-layout-<%= card.layout || 'text_first' %> math-content math-lazy">
      <div>
        <% if (!imageOnly) { %>
          <span class="card-index">Mục <%= index + 1 %> · <%= typeLabel(card.type) %></span>
          <h2><%= card.title %></h2>

          <% if (card.display_text) { %>
            <p class="theory-display-text"><%= card.display_text %></p>
          <% } %>

          <%- gridRenderHtml(card.grid_layout) %>
        <% } %>

        <% if (images.length > 0) { %>
          <div class="theory-image-row">
            <% images.forEach((image) => { %>
              <span class="question-image">
                <img src="<%= image.url %>" alt="<%= image.alt_text || 'Hình minh họa lý thuyết' %>" loading="lazy" decoding="async">
              </span>
            <% }) %>
          </div>
        <% } %>

        <% if (!imageOnly) { %>
          <% if (bodyValue(card)) { %>
            <div class="theory-body"><%= bodyValue(card) %></div>
          <% } %>

          <% if (card.student_task) { %>
            <p class="theory-task"><strong>Em cần làm:</strong> <%= card.student_task %></p>
          <% } %>

          <% if (card.example) { %>
            <p class="muted"><strong>Ví dụ:</strong> <%= card.example %></p>
          <% } %>

          <% if (card.remember) { %>
            <p class="theory-remember"><strong>Ghi nhớ:</strong> <%= card.remember %></p>
          <% } %>
        <% } %>
      </div>
      <% if (aiHelpEnabled && !imageOnly) { %>
      <button
        class="btn btn-secondary theory-help-button"
        type="button"
        data-lesson-id="<%= lesson.id %>"
        data-card-index="<%= index %>">
        <i data-lucide="message-circle" class="lucide-icon"></i>
        Gợi ý thêm dễ hiểu hơn
      </button>
      <div class="ai-inline-reply" hidden></div>
      <% } %>
    </article>
  <% }) %>
</section>

<nav class="lesson-navigation" aria-label="Điều hướng bài học">
  <a class="btn btn-secondary" href="/student/dashboard">
    <i data-lucide="list" class="lucide-icon"></i>
    Danh sách bài học
  </a>
  <% if (nextLesson) { %>
    <a class="btn btn-primary lesson-next-button" href="/student/lessons/<%= nextLesson.id %>">
      <span>
        <strong>Bài tiếp theo</strong>
        <small><%= nextLesson.lesson_name %></small>
      </span>
      <i data-lucide="arrow-right" class="lucide-icon"></i>
    </a>
  <% } %>
</nav>
<%
  if (typeof pageStyles !== 'undefined') pageStyles.push('/css/student/lesson.css');
  if (typeof pageScripts !== 'undefined') pageScripts.push('/js/student/lesson.js');
%>
