<%
  const answerByQuestion = new Map((answers || []).map((answer) => [Number(answer.question_id), answer]));
  const chatsByQuestion = new Map();
  (chats || []).forEach((chat) => {
    const key = Number(chat.question_id || 0);
    if (!chatsByQuestion.has(key)) chatsByQuestion.set(key, []);
    chatsByQuestion.get(key).push(chat);
  });

  function escapeHtml(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function escapeAttribute(value) {
    return escapeHtml(value).replace(/`/g, '&#096;');
  }

  function imageHtml(image, fallbackAlt) {
    const width = Math.min(Math.max(Number(image.width_percent || image.width || 100), 20), 100);
    return `
      <span class="question-image" style="max-width:${width}%">
        <img src="${escapeAttribute(image.url || '')}" alt="${escapeAttribute(image.alt_text || image.alt || fallbackAlt)}">
      </span>
    `;
  }

  function imageRowHtml(images, fallbackAlt, className = 'explanation-image-row') {
    if (!Array.isArray(images) || images.length === 0) return '';
    return `<div class="${className}">${images.map((image) => imageHtml(image, fallbackAlt)).join('')}</div>`;
  }

  function questionLayoutClass(question) {
    if (question.layout_template === 'SPLIT_HORIZONTAL_LEFT_IMAGE') return 'question-split-layout image-left';
    if (question.layout_template === 'SPLIT_HORIZONTAL_RIGHT_IMAGE') return 'question-split-layout image-right';
    return '';
  }

  function questionContentHtml(question) {
    const content = question.content || {};
    const images = Array.isArray(content.images) ? content.images : [];
    let rawText = String(content.text || '');

    images.forEach((image) => {
      rawText = rawText.replaceAll(`[${image.id}]`, '');
    });

    const textHtml = `<div class="question-text-row">${escapeHtml(rawText).replace(/\r?\n/g, '<br>')}</div>`;
    const imageHtmlBlock = imageRowHtml(images, 'Hình minh họa đề bài', 'question-image-row split-image-row');

    if (question.layout_template === 'SPLIT_HORIZONTAL_LEFT_IMAGE') return `<div class="${questionLayoutClass(question)}">${imageHtmlBlock}${textHtml}</div>`;
    if (question.layout_template === 'SPLIT_HORIZONTAL_RIGHT_IMAGE') return `<div class="${questionLayoutClass(question)}">${textHtml}${imageHtmlBlock}</div>`;
    return `${textHtml}${imageRowHtml(images, 'Hình minh họa đề bài', 'question-image-row')}`;
  }

  const answeredCount = (answers || []).length;
  const correctCount = (answers || []).filter((answer) => Number(answer.is_correct) === 1 || answer.is_correct === true).length;
  const wrongCount = answeredCount - correctCount;
%>

<section class="workspace-head">
  <div>
    <p class="eyebrow">Xem lại bài làm</p>
    <h1><%= session.title %></h1>
    <p><%= session.status === 'COMPLETED' ? 'Lần làm bài đã kết thúc.' : 'Lần làm bài này đang làm dở.' %> Dùng trang này để xem câu đúng, câu sai và lời giải.</p>
  </div>
  <div class="row-actions">
    <% if (session.status === 'IN_PROGRESS') { %>
      <a class="btn btn-secondary" href="/student/sessions/<%= session.id %>/practice">
        <i data-lucide="play-circle" class="lucide-icon"></i>
        Tiếp tục làm
      </a>
    <% } %>
    <a class="btn btn-primary" href="/student/history">
      <i data-lucide="history" class="lucide-icon"></i>
      Về lịch sử
    </a>
  </div>
</section>

<section class="stat-grid">
  <article class="stat-card">
    <span class="status-pill status-completed">Đúng</span>
    <strong class="stat-value"><%= correctCount %></strong>
    <p class="muted">Câu đã trả lời đúng.</p>
  </article>
  <article class="stat-card">
    <span class="status-pill status-review">Cần xem lại</span>
    <strong class="stat-value"><%= wrongCount %></strong>
    <p class="muted">Câu đã làm sai hoặc cần luyện lại.</p>
  </article>
  <article class="stat-card">
    <span class="status-pill status-in-progress">Tiến trình</span>
    <strong class="stat-value"><%= session.current_index %>/<%= session.question_count %></strong>
    <p class="muted">Trạng thái: <%= session.status === 'COMPLETED' ? 'Đã kết thúc' : 'Đang làm dở' %>.</p>
  </article>
</section>

<section class="learning-summary">
  <div>
    <div class="section-title">
      <i data-lucide="clock" class="lucide-icon"></i>
      Thời gian
    </div>
    <p>Bắt đầu: <strong><%= session.started_at ? new Date(session.started_at).toLocaleString('vi-VN') : '-' %></strong></p>
    <p>Kết thúc: <strong><%= session.completed_at ? new Date(session.completed_at).toLocaleString('vi-VN') : '-' %></strong></p>
  </div>
  <div>
    <div class="section-title">
      <i data-lucide="message-circle" class="lucide-icon"></i>
      Gợi ý thêm
    </div>
    <p>Các trao đổi gợi ý thêm được lưu theo từng câu để em xem lại cách được hướng dẫn.</p>
  </div>
</section>

<section class="review-list">
  <% if (wrongCount > 0) { %>
    <%# Bài 15-20 câu thì trang xem lại rất dài; nút lọc giúp em nhảy thẳng tới
        các câu cần sửa thay vì cuộn qua cả các câu đã đúng. %>
    <div class="review-filter" role="group" aria-label="Lọc danh sách câu hỏi">
      <button type="button" class="btn btn-secondary active" data-review-filter="all">
        <i data-lucide="list" class="lucide-icon"></i>
        Tất cả câu (<%= questions.length %>)
      </button>
      <button type="button" class="btn btn-secondary" data-review-filter="wrong">
        <i data-lucide="circle-x" class="lucide-icon"></i>
        Chỉ xem câu sai (<%= wrongCount %>)
      </button>
    </div>
  <% } %>
  <% questions.forEach((question, index) => { %>
    <% const answer = answerByQuestion.get(Number(question.id)); %>
    <% const questionChats = chatsByQuestion.get(Number(question.id)) || []; %>
    <% const laCauSai = Boolean(answer) && Number(answer.is_correct) !== 1; %>
    <article class="review-item" data-review-result="<%= laCauSai ? 'wrong' : 'ok' %>">
      <div class="section-title">
        <i data-lucide="circle-help" class="lucide-icon"></i>
        Câu <%= index + 1 %>
      </div>
      <div class="question-content math-content"><%- questionContentHtml(question) %></div>
      <div class="answer-grid review-answer-grid <%= question.layout_template === 'IMAGE_IN_CHOICES' ? 'answer-grid-image-choices' : '' %>">
        <% question.choices.forEach((choice) => { %>
          <div class="answer-choice preview-choice <%= choice.key === question.correct_answer ? 'correct' : '' %> <%= answer && choice.key === answer.selected_answer && Number(answer.is_correct) !== 1 ? 'wrong' : '' %>">
            <span><%= choice.key %></span>
            <div class="choice-body">
              <strong><%= choice.text || 'Đáp án bằng hình ảnh' %></strong>
              <%- imageRowHtml(choice.images || [], `Hình minh họa đáp án ${choice.key}`, 'choice-image-row') %>
            </div>
          </div>
        <% }) %>
      </div>
      <div class="review-meta">
        <span>Em chọn: <strong><%= answer?.selected_answer || 'Chưa làm' %></strong></span>
        <span>Đáp án đúng: <strong><%= question.correct_answer %></strong></span>
        <% if (answer) { %>
          <% if (Number(answer.is_correct) === 1) { %>
            <span class="status-pill status-completed">Đúng</span>
          <% } else { %>
            <span class="status-pill status-review">Cần xem lại</span>
          <% } %>
        <% } %>
      </div>
      <% if (question.explanation?.text || (question.explanation?.images || []).length > 0) { %>
        <div class="review-explanation">
          <strong>Lời giải:</strong>
          <%- imageRowHtml(question.explanation.images, 'Hình minh họa lời giải') %>
          <%# Escape rồi mới đổi ky tu xuong dong thanh the br: in truc tiep
              bang the EJS thuan thi loi giai nhieu dong bi don thanh mot dong
              vi HTML nuot ky tu xuong dong. %>
          <span class="math-content"><%- escapeHtml(question.explanation.text).replace(/\r?\n/g, '<br>') %></span>
        </div>
      <% } %>
      <% if (questionChats.length > 0) { %>
        <div class="review-chat">
          <strong>Trao đổi gợi ý thêm trong câu này</strong>
          <% questionChats.forEach((chat) => { %>
            <div class="chat-message <%= chat.role === 'student' ? 'student' : 'ai' %>"><%= chat.message %></div>
          <% }) %>
        </div>
      <% } %>
    </article>
  <% }) %>
</section>
<%
  if (typeof pageStyles !== 'undefined') pageStyles.push('/css/student/session-review.css');
  if (typeof pageScripts !== 'undefined') pageScripts.push('/js/student/session-review.js');
%>
