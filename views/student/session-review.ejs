<%
  const answerByQuestion = new Map((answers || []).map((answer) => [Number(answer.question_id), answer]));
  const chatsByQuestion = new Map();
  (chats || []).forEach((chat) => {
    const key = Number(chat.question_id || 0);
    if (!chatsByQuestion.has(key)) chatsByQuestion.set(key, []);
    chatsByQuestion.get(key).push(chat);
  });


  const answeredCount = (answers || []).length;
  const correctCount = (answers || []).filter((answer) => Number(answer.is_correct) === 1 || answer.is_correct === true).length;
  const wrongCount = answeredCount - correctCount;
%>

<section class="workspace-head">
  <div>
    <p class="eyebrow">Xem lại bài làm</p>
    <h1><%= session.title %></h1>
    <p><%= session.status === 'COMPLETED' ? 'Lần làm bài đã kết thúc.' : 'Lần làm bài này đang làm dở.' %> Dùng trang này để xem câu đúng, câu sai và lời giải.</p>
  </div>
  <div class="row-actions">
    <% if (session.status === 'IN_PROGRESS') { %>
      <a class="btn btn-secondary" href="/student/sessions/<%= session.id %>/practice">
        <i data-lucide="play-circle" class="lucide-icon"></i>
        Tiếp tục làm
      </a>
    <% } %>
    <a class="btn btn-primary" href="/student/history">
      <i data-lucide="history" class="lucide-icon"></i>
      Về lịch sử
    </a>
  </div>
</section>

<% if (session.completion_reason === 'CONTENT_UNAVAILABLE') { %>
  <section class="flash flash-warning" role="status">
    Nội dung của một số câu trong phiên cũ không còn trong ngân hàng nên không thể phục hồi trung thực.
    Hệ thống đã giữ nguyên phần lịch sử còn lại và không tự thay bằng câu khác.
  </section>
<% } %>

<section class="stat-grid">
  <article class="stat-card">
    <span class="status-pill status-completed">Đúng</span>
    <strong class="stat-value"><%= correctCount %></strong>
    <p class="muted">Câu đã trả lời đúng.</p>
  </article>
  <article class="stat-card">
    <span class="status-pill status-review">Cần xem lại</span>
    <strong class="stat-value"><%= wrongCount %></strong>
    <p class="muted">Câu đã làm sai hoặc cần luyện lại.</p>
  </article>
  <article class="stat-card">
    <span class="status-pill status-in-progress">Tiến trình</span>
    <strong class="stat-value"><%= session.current_index %>/<%= session.question_count %></strong>
    <p class="muted">Trạng thái: <%= session.status === 'COMPLETED' ? 'Đã kết thúc' : 'Đang làm dở' %>.</p>
  </article>
</section>

<section class="learning-summary">
  <div>
    <div class="section-title">
      <i data-lucide="clock" class="lucide-icon"></i>
      Thời gian
    </div>
    <p>Bắt đầu: <strong><%= session.started_at ? new Date(session.started_at).toLocaleString('vi-VN') : '-' %></strong></p>
    <p>Kết thúc: <strong><%= session.completed_at ? new Date(session.completed_at).toLocaleString('vi-VN') : '-' %></strong></p>
  </div>
  <div>
    <div class="section-title">
      <i data-lucide="message-circle" class="lucide-icon"></i>
      Gợi ý thêm
    </div>
    <p>Các trao đổi gợi ý thêm được lưu theo từng câu để em xem lại cách được hướng dẫn.</p>
  </div>
</section>

<section id="reviewQuestionList" class="review-list">
  <% if (wrongCount > 0) { %>
    <%# Bài 15-20 câu thì trang xem lại rất dài; nút lọc giúp em nhảy thẳng tới
        các câu cần sửa thay vì cuộn qua cả các câu đã đúng. %>
    <div class="review-filter" role="group" aria-label="Lọc danh sách câu hỏi">
      <button type="button" class="btn btn-secondary active" data-review-filter="all" aria-pressed="true" aria-controls="reviewQuestionList">
        <i data-lucide="list" class="lucide-icon"></i>
        Tất cả câu (<%= questions.length %>)
      </button>
      <button type="button" class="btn btn-secondary" data-review-filter="wrong" aria-pressed="false" aria-controls="reviewQuestionList">
        <i data-lucide="circle-x" class="lucide-icon"></i>
        Chỉ xem câu sai (<%= wrongCount %>)
      </button>
    </div>
  <% } %>
  <% questions.forEach((question, index) => { %>
    <% const answer = answerByQuestion.get(Number(question.id)); %>
    <% const questionChats = chatsByQuestion.get(Number(question.id)) || []; %>
    <% const laCauSai = Boolean(answer) && Number(answer.is_correct) !== 1; %>
    <article class="review-item" data-review-result="<%= laCauSai ? 'wrong' : 'ok' %>">
      <div class="section-title">
        <i data-lucide="circle-help" class="lucide-icon"></i>
        Câu <%= index + 1 %>
      </div>
      <div class="question-content math-content"><%- contentRenderer.renderQuestionContent(question, {
        preview: true,
        selectedAnswer: answer?.selected_answer,
        correctAnswer: question.correct_answer
      }) %></div>
      <%- contentRenderer.renderAnswerArea(question, {
        preview: true,
        selectedAnswer: answer?.selected_answer,
        correctAnswer: question.correct_answer
      }) %>
      <div class="review-meta">
        <span>Em chọn: <strong><%= answer?.selected_answer || 'Chưa làm' %></strong></span>
        <span>Đáp án đúng: <strong><%= question.correct_answer %></strong></span>
        <% if (answer) { %>
          <% if (Number(answer.is_correct) === 1) { %>
            <span class="status-pill status-completed">Đúng</span>
          <% } else { %>
            <span class="status-pill status-review">Cần xem lại</span>
          <% } %>
        <% } %>
      </div>
      <% if (question.explanation?.text || (question.explanation?.images || []).length > 0) { %>
        <div class="review-explanation math-content">
          <strong>Lời giải:</strong>
          <%- contentRenderer.renderExplanationContent(question.explanation) %>
        </div>
      <% } %>
      <% if (questionChats.length > 0) { %>
        <div class="review-chat">
          <strong>Trao đổi gợi ý thêm trong câu này</strong>
          <% questionChats.forEach((chat) => { %>
            <div class="chat-message <%= chat.role === 'student' ? 'student' : 'ai' %>"><%= chat.message %></div>
          <% }) %>
        </div>
      <% } %>
    </article>
  <% }) %>
</section>
<%
  if (typeof pageStyles !== 'undefined') {
    pageStyles.push('/css/student/question-image-viewer.css');
    pageStyles.push('/css/student/session-review.css');
  }
  if (typeof pageScripts !== 'undefined') {
    pageScripts.push('/js/student/question-image-viewer.js');
    pageScripts.push('/js/student/session-review.js');
  }
%>
