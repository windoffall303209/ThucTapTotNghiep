<%# Mẫu giao diện account kết hợp dữ liệu máy chủ với HTML để hiển thị một màn hình của ứng dụng. %>
<section class="workspace-head">
  <div>
    <p class="eyebrow">Tài khoản</p>
    <h1>Hồ sơ học sinh</h1>
    <p>Kiểm tra thông tin học tập và cập nhật mật khẩu đăng nhập khi cần.</p>
  </div>
</section>

<section class="account-grid">
  <article class="info-panel">
    <div class="section-title">
      <i data-lucide="user-circle" class="lucide-icon"></i>
      Thông tin cá nhân
    </div>
    <dl class="account-details">
      <div>
        <dt>Họ tên</dt>
        <dd><%= account.fullname %></dd>
      </div>
      <div>
        <dt>Tên đăng nhập</dt>
        <dd><%= account.username %></dd>
      </div>
      <div>
        <dt>Lớp đăng ký</dt>
        <dd>Lớp <%= account.registered_grade || account.current_grade %></dd>
      </div>
      <div>
        <dt>Lớp hiện tại</dt>
        <dd>Lớp <%= account.current_grade %></dd>
      </div>
      <div>
        <dt>Ngày tạo</dt>
        <dd><%= account.created_at ? new Date(account.created_at).toLocaleString('vi-VN') : '-' %></dd>
      </div>
    </dl>
    <div class="recovery-email" aria-labelledby="recovery-email-title" data-recovery-email-editor>
      <div class="recovery-email-head">
        <div>
          <h2 id="recovery-email-title">Email khôi phục</h2>
          <p>Chỉ email đã xác thực mới được dùng để lấy lại mật khẩu.</p>
        </div>
        <% if (account.email && account.email_verified_at) { %>
          <span class="email-status email-status-verified"><i data-lucide="badge-check" class="lucide-icon"></i>Đã xác thực</span>
        <% } else { %>
          <span class="email-status"><i data-lucide="shield-alert" class="lucide-icon"></i>Chưa xác thực</span>
        <% } %>
      </div>

      <% if (account.email && account.email_verified_at) { %>
        <div class="verified-email-row">
          <p class="verified-email"><i data-lucide="mail-check" class="lucide-icon"></i><%= account.email %></p>
          <button class="btn btn-secondary email-edit-button" type="button" data-email-edit-trigger <%= account.pending_email ? 'hidden' : '' %>>
            <i data-lucide="pencil" class="lucide-icon"></i>
            Sửa
          </button>
        </div>
      <% } %>

      <form class="stack-form email-request-form" action="/student/account/email" method="post" data-email-edit-form <%= account.email_verified_at && !account.pending_email ? 'hidden' : '' %>>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="recovery-email-input">Địa chỉ email</label>
        <div class="email-request-row">
          <input id="recovery-email-input" name="email" type="email" inputmode="email" autocomplete="email" maxlength="254" value="<%= account.pending_email || account.email || '' %>" data-verified-email="<%= account.email_verified_at ? account.email : '' %>" placeholder="vidu@email.com" required>
          <div class="email-request-actions">
            <% if (account.email && account.email_verified_at && !account.pending_email) { %>
              <button class="btn btn-secondary" type="button" data-email-edit-cancel>Hủy</button>
            <% } %>
            <button class="btn btn-secondary" type="submit">
              <i data-lucide="send" class="lucide-icon"></i>
              <%= account.pending_email ? 'Gửi lại mã' : 'Gửi mã' %>
            </button>
          </div>
        </div>
      </form>

      <% if (account.pending_email) { %>
        <form class="stack-form email-code-form" action="/student/account/email/verify" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <fieldset class="verification-code-fieldset" data-verification-code-group>
            <legend>Mã xác thực 6 số đã gửi đến <strong><%= account.pending_email %></strong></legend>
            <input type="hidden" name="verification_code" data-verification-code-value>
            <div class="verification-code-boxes" role="group" aria-label="Mã xác thực 6 số">
              <% for (let digitIndex = 1; digitIndex <= 6; digitIndex += 1) { %>
                <input type="text" inputmode="numeric" <%= digitIndex === 1 ? 'autocomplete="one-time-code"' : 'autocomplete="off"' %> maxlength="1" pattern="[0-9]" aria-label="Chữ số <%= digitIndex %>" data-verification-digit required>
              <% } %>
            </div>
          </fieldset>
          <div class="email-code-actions">
            <button class="btn btn-primary" type="submit">
              <i data-lucide="badge-check" class="lucide-icon"></i>
              Xác nhận email
            </button>
            <button class="btn btn-danger email-code-cancel" type="submit" formaction="/student/account/email/cancel" formnovalidate>
              <i data-lucide="x" class="lucide-icon"></i>
              Hủy
            </button>
          </div>
        </form>
      <% } %>
    </div>
    <p class="form-note">Nếu cần đổi lớp học, hãy nhờ phụ huynh hoặc quản trị viên hỗ trợ.</p>
  </article>

  <article class="info-panel">
    <div class="section-title">
      <i data-lucide="lock-keyhole" class="lucide-icon"></i>
      Bảo mật tài khoản
    </div>
    <form class="stack-form" action="/student/account/password" method="post" data-password-match-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>
        Mật khẩu hiện tại
        <span class="password-field">
          <input name="current_password" type="password" autocomplete="current-password" maxlength="72" required>
          <button type="button" class="password-toggle" data-password-toggle aria-label="Hiện mật khẩu" aria-pressed="false">
            <i data-lucide="eye" class="lucide-icon"></i>
          </button>
        </span>
      </label>
      <label>
        Mật khẩu mới
        <span class="password-field">
          <input name="new_password" type="password" autocomplete="new-password" minlength="10" maxlength="72" data-password-policy data-password-primary required>
          <button type="button" class="password-toggle" data-password-toggle aria-label="Hiện mật khẩu" aria-pressed="false">
            <i data-lucide="eye" class="lucide-icon"></i>
          </button>
        </span>
      </label>
      <label>
        Xác nhận mật khẩu mới
        <span class="password-field">
          <input name="confirm_password" type="password" autocomplete="new-password" minlength="10" maxlength="72" data-password-confirm required>
          <button type="button" class="password-toggle" data-password-toggle aria-label="Hiện mật khẩu" aria-pressed="false">
            <i data-lucide="eye" class="lucide-icon"></i>
          </button>
        </span>
      </label>
      <p class="form-note">Mật khẩu mới cần ít nhất 10 ký tự, có chữ hoa, chữ thường, chữ số và ký tự đặc biệt; không dùng khoảng trắng.</p>
      <button class="btn btn-primary" type="submit">
        <i data-lucide="save" class="lucide-icon"></i>
        Lưu mật khẩu mới
      </button>
    </form>
  </article>
</section>
<%# Khối xử lý trong mẫu quyết định nội dung giao diện dựa trên dữ liệu máy chủ. %>
<% if (typeof pageStyles !== 'undefined') pageStyles.push('/css/student/account.css'); %>
<% if (typeof pageScripts !== 'undefined') pageScripts.push('/js/auth/common.js'); %>
