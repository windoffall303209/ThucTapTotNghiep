<%# M?u giao di?n history k?t h?p d? li?u m?y ch? v?i HTML ?? hi?n th? m?t m?n h?nh c?a ?ng d?ng. %>
<%
  const sessionRows = [
    ...(sessions || []),
    ...(legacySessions || [])
  ].sort((a, b) => new Date(b.started_at || 0) - new Date(a.started_at || 0));
%>

<section class="workspace-head">
  <div>
    <p class="eyebrow">Lịch sử học tập</p>
    <h1>Các lần luyện tập của em</h1>
    <p>Xem lại đề đang làm dở, kết quả đã hoàn thành và các câu cần ôn lại.</p>
  </div>
  <a class="btn btn-primary" href="/student/exams">
    <i data-lucide="clipboard-list" class="lucide-icon"></i>
    Tạo bài luyện mới
  </a>
</section>

<section class="table-section">
  <div class="section-title">
    <i data-lucide="history" class="lucide-icon"></i>
    Nhật ký luyện tập
  </div>

  <%# Kh?i ?i?u ki?n trong m?u quy?t ??nh n?i dung giao di?n d?a tr?n d? li?u m?y ch?. %>
  <% if (!sessionRows || sessionRows.length === 0) { %>
    <div class="empty-state compact">
      <p>Em chưa có bài luyện nào. Bấm "Tạo bài luyện mới" để làm bài đầu tiên nhé!</p>
    </div>
  <% } else { %>
    <div class="card-list">
      <%# Kh?i l?p trong m?u t?o n?i dung ??ng t? danh s?ch d? li?u m?y ch?. %>
      <% sessionRows.forEach((session) => { %>
        <%# Kh?i chu?n b? d? li?u t?o gi? tr? trung gian cho ph?n giao di?n b?n d??i. %>
        <% const answered = Number(session.answered_count || 0); %>
        <%# Kh?i chu?n b? d? li?u t?o gi? tr? trung gian cho ph?n giao di?n b?n d??i. %>
        <% const total = Number(session.question_count || 0); %>
        <%# Kh?i chu?n b? d? li?u t?o gi? tr? trung gian cho ph?n giao di?n b?n d??i. %>
        <% const percent = total ? Math.round((Number(session.current_index || 0) / total) * 100) : 0; %>
        <article class="activity-card">
          <div class="row-actions">
            <%# Kh?i ?i?u ki?n trong m?u quy?t ??nh n?i dung giao di?n d?a tr?n d? li?u m?y ch?. %>
            <% if (session.status === 'COMPLETED') { %>
              <span class="status-pill status-completed">Đã kết thúc</span>
            <% } else { %>
              <span class="status-pill status-in-progress">Đang làm dở</span>
            <% } %>
            <span class="status-pill status-new">
              <%= session.session_mode === 'CHAPTER'
                ? 'Theo chương'
                : session.session_mode === 'COMPREHENSIVE'
                  ? 'Tổng hợp'
                  : session.session_mode === 'REVIEW'
                    ? 'Ôn lý thuyết'
                    : session.session_mode === 'LEGACY'
                      ? 'Bài trước đây'
                      : 'Theo bài' %>
            </span>
          </div>
          <h2><%= session.title %></h2>
          <%# Bỏ metric "N tin nhắn gợi ý": con số nội bộ của nhật ký AI, không
              giúp gì cho học sinh khi xem lại bài. %>
          <p class="muted">Đúng <strong><%= session.correct_count %></strong>/<strong><%= answered %></strong> câu · Đã làm <%= session.current_index %>/<%= session.question_count %> câu.</p>
          <div
            class="progress-track"
            role="progressbar"
            aria-valuenow="<%= Math.min(Math.max(percent, 0), 100) %>"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-label="Đã làm <%= session.current_index %> trên <%= session.question_count %> câu">
            <span style="width: <%= Math.min(Math.max(percent, 0), 100) %>%"></span>
          </div>
          <p class="muted">Bắt đầu: <%= session.started_at ? new Date(session.started_at).toLocaleString('vi-VN') : '-' %></p>
          <div class="row-actions">
            <%# Kh?i ?i?u ki?n trong m?u quy?t ??nh n?i dung giao di?n d?a tr?n d? li?u m?y ch?. %>
            <% if (session.status === 'IN_PROGRESS') { %>
              <a class="btn btn-secondary" href="/student/sessions/<%= session.id %>/practice">
                <i data-lucide="play-circle" class="lucide-icon"></i>
                Tiếp tục
              </a>
            <% } %>
            <%# Kh?i ?i?u ki?n trong m?u quy?t ??nh n?i dung giao di?n d?a tr?n d? li?u m?y ch?. %>
            <% if (session.session_mode !== 'LEGACY') { %>
              <a class="btn btn-primary" href="/student/sessions/<%= session.id %>">
                <i data-lucide="eye" class="lucide-icon"></i>
                Xem lại
              </a>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>
<%# Kh?i ?i?u ki?n trong m?u quy?t ??nh n?i dung giao di?n d?a tr?n d? li?u m?y ch?. %>
<% if (typeof pageStyles !== 'undefined') pageStyles.push('/css/student/history.css'); %>
