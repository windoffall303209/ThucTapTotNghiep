<%# M?u giao di?n index k?t h?p d? li?u m?y ch? v?i HTML ?? hi?n th? m?t m?n h?nh c?a ?ng d?ng. %>
<section class="home-hero landing-hero">
  <div class="hero-copy">
    <p class="eyebrow">Ôn luyện Toán Tiểu học <%= shortGradeRangeLabel %></p>
    <h1>Học đúng bài, luyện đúng phần còn yếu.</h1>
    <p class="hero-text">
      Toán Bổ Trợ Tiểu học giúp học sinh đi theo chương trình đang học: đọc lý thuyết ngắn, làm câu hỏi có lời giải, xem lại lỗi sai và nhận gợi ý thêm khi thật sự cần.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/auth/register">
        <i data-lucide="user-plus" class="lucide-icon"></i>
        Tạo tài khoản học sinh
      </a>
      <a class="btn btn-secondary" href="#cach-hoc">
        <i data-lucide="route" class="lucide-icon"></i>
        Xem cách học
      </a>
    </div>
  </div>

  <aside class="hero-board landing-preview" aria-label="Minh họa lộ trình học">
    <span class="demo-label">Minh họa lộ trình, không phải dữ liệu cá nhân</span>
    <div class="path-list">
      <div class="step-card">
        <strong>1. Chọn lớp</strong>
        <p class="muted">Nội dung chỉ hiển thị theo lớp học của từng học sinh.</p>
      </div>
      <div class="step-card">
        <strong>2. Học theo bài</strong>
        <p class="muted">Mỗi bài có lý thuyết, ví dụ và câu hỏi luyện tập.</p>
      </div>
      <div class="step-card">
        <strong>3. Xem lại lỗi sai</strong>
        <p class="muted">Hệ thống lưu lịch sử để gợi ý bài cần ôn lại.</p>
      </div>
    </div>
  </aside>
</section>

<section id="cach-hoc" class="landing-section">
  <div class="section-title">
    <i data-lucide="map" class="lucide-icon"></i>
    Cách học trong 3 bước
  </div>
  <div class="step-list">
    <article class="step-card">
      <i data-lucide="book-open" class="feature-icon"></i>
      <strong>Đọc lý thuyết ngắn</strong>
      <p class="muted">Nắm ý chính của bài trước khi làm câu hỏi, có hỗ trợ công thức Toán.</p>
    </article>
    <article class="step-card">
      <i data-lucide="mouse-pointer-click" class="feature-icon"></i>
      <strong>Luyện từng câu</strong>
      <p class="muted">Chọn đáp án, nhận phản hồi đúng/sai và xem lời giải sau khi thử.</p>
    </article>
    <article class="step-card">
      <i data-lucide="refresh-cw" class="feature-icon"></i>
      <strong>Ôn lại điểm yếu</strong>
      <p class="muted">Bài làm sai được ghi nhận để học sinh quay lại đúng phần cần luyện.</p>
    </article>
  </div>
</section>

<section id="chuong-trinh" class="landing-section">
  <div class="section-title">
    <i data-lucide="graduation-cap" class="lucide-icon"></i>
    Chương trình <%= gradeRangeLabel %>
  </div>
  <div class="grade-grid" aria-label="Các khối lớp hỗ trợ">
    <%# Kh?i l?p trong m?u t?o n?i dung ??ng t? danh s?ch d? li?u m?y ch?. %>
    <% gradeOptions.forEach((grade) => { %>
      <article class="grade-card">
        <strong><%= grade.label %></strong>
        <small class="muted">Học theo chương, bài và câu hỏi tương ứng.</small>
      </article>
    <% }) %>
  </div>
</section>

<section class="landing-section feature-strip">
  <div>
    <i data-lucide="database" class="feature-icon"></i>
    <h2>Dữ liệu học tập thật</h2>
    <p>Tiến trình chỉ xuất hiện sau khi học sinh đăng nhập và làm bài, không dùng số demo gây hiểu nhầm.</p>
  </div>
  <div>
    <i data-lucide="brain" class="feature-icon"></i>
    <h2>Gợi ý thêm có kiểm soát</h2>
    <p>Tính năng hỗ trợ giải thích từng bước chỉ đóng vai trò phụ và không thay thế đáp án chuẩn trong ngân hàng câu hỏi.</p>
  </div>
  <div>
    <i data-lucide="shield-check" class="feature-icon"></i>
    <h2>Phù hợp phụ huynh theo dõi</h2>
    <p>Lịch sử làm bài và bài cần ôn giúp biết học sinh đang vướng ở đâu.</p>
  </div>
</section>
<%# Kh?i ?i?u ki?n trong m?u quy?t ??nh n?i dung giao di?n d?a tr?n d? li?u m?y ch?. %>
<% if (typeof pageStyles !== 'undefined') pageStyles.push('/css/home/index.css'); %>
